{
  "name": "web-konzerte",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm types && astro dev",
    "build": "pnpm types && astro check && astro build && node scripts/check-cloudflare-build.mjs",
    "od": "pnpm types && astro check && astro build && node scripts/deploy-opendesign.mjs",
    "preview": "pnpm types && astro preview",
    "test": "node --experimental-strip-types scripts/check-concerts.mjs && node --experimental-strip-types scripts/check-availability.mjs",
    "types": "wrangler types --env-file .dev.vars.example",
    "quality": "pnpm test && vp check . && pnpm build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.6",
    "@astrojs/react": "^6.0.4",
    "@internationalized/date": "^3.12.3",
    "astro": "^7.2.10",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro-eslint-parser": "^2.1.0",
    "eslint-plugin-astro": "^2.1.1",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.2",
    "wrangler": "^4.126.0"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.2.2"
  }
}
