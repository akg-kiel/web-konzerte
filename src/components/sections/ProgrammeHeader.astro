---
import PageHero from './PageHero.astro';
import ProgrammeNavigation from './ProgrammeNavigation.astro';
---

<PageHero
  eyebrow="Konzertprogramm"
  intro="Klassik, Chor, Musical und Crossover – Konzerte in der Petruskirche."
>
  Konzerte in Kiel
</PageHero>

<section class="border-y border-white/5 bg-surface/50 py-12" aria-label="Konzertsuche">
  <div class="mx-auto w-full max-w-screen-2xl px-6 md:px-8 lg:px-16">
    <ProgrammeNavigation />
    <slot />
  </div>
</section>
