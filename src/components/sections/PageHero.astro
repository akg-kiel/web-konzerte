---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  intro?: string;
  subtitle?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
}

const { eyebrow, intro, subtitle, image, imageAlt = '', imagePosition = 'center center' } = Astro.props;
const hasImage = Boolean(image);
---

<section
  aria-labelledby="page-hero-heading"
  class:list={[
    'relative overflow-hidden bg-role-dominant text-role-on',
    hasImage
      ? 'flex min-h-[68svh] items-end pt-28 pb-16 md:min-h-[82svh] md:pb-28'
      : 'pt-32 pb-14 md:pb-20'
  ]}
>
  {
    hasImage && (
      <>
        <Image
          src={image!}
          alt={imageAlt}
          class="absolute inset-0 !h-full !w-full object-cover"
          style={`object-position: ${imagePosition};`}
          widths={[640, 960, 1280, 1600, 1920]}
          sizes="100vw"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          format="webp"
        />
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-[linear-gradient(to_bottom,rgba(2,6,23,0.45)_0%,rgba(2,6,23,0.28)_42%,rgba(2,6,23,0.7)_78%,rgb(2,6,23)_100%)]"
        />
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-[linear-gradient(90deg,rgba(2,6,23,0.55)_0%,rgba(2,6,23,0.14)_48%,rgba(2,6,23,0.28)_100%)]"
        />
      </>
    )
  }

  <div class="site-container relative z-10 w-full">
    <slot name="badge" />
    {
      eyebrow && (
        <p class="section-label mb-5">{eyebrow}</p>
      )
    }
    <h1
      id="page-hero-heading"
      class="font-display text-[clamp(2.6rem,8vw,5.4rem)] font-normal leading-[1.02] tracking-[-0.045em] text-white"
    >
      <slot />
    </h1>
    {
      subtitle && (
        <p class="mt-5 font-display text-[clamp(1.5rem,4vw,2.3rem)] font-normal leading-tight text-secondary/90">
          {subtitle}
        </p>
      )
    }
    {
      intro && (
        <p class="mt-6 max-w-2xl font-body text-lg leading-8 text-role-on/74">
          {intro}
        </p>
      )
    }
    <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
      <slot name="cta" />
    </div>
  </div>
</section>
