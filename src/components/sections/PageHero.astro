---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import fallbackImage from '../../assets/concerts/venue-fallback.webp';

interface Props {
  eyebrow?: string;
  intro?: string;
  subtitle?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  imagePosition?: string;
}

const { eyebrow, intro, subtitle, image, imageAlt = '', imagePosition = 'center center' } = Astro.props;
const imageQuality = 80;
const hasImage = Boolean(image);
const hasCta = Astro.slots.has('cta');
---

<section
  aria-labelledby="page-hero-heading"
  data-page-motion={hasImage ? 'stage' : 'quiet'}
  class:list={[
    'page-hero relative overflow-hidden bg-role-dominant text-role-on',
    hasImage
      ? 'flex min-h-[60svh] items-end pb-10 pt-28 md:min-h-[64svh] md:pb-16'
      : 'pt-32 pb-10 md:pb-14'
  ]}
>
  {
    hasImage && (
      <>
        {typeof image === 'string' ? (
          <Image
            src={image}
            alt={imageAlt}
            class="page-stage-image absolute inset-0 h-full w-full object-cover"
            style={`object-position: ${imagePosition};`}
            width={1920}
            height={1080}
            widths={[640, 960, 1280, 1600, 1920]}
            sizes="100vw"
            priority
            format="webp"
            quality={imageQuality}
            onerror={`this.onerror=null;this.srcset='';this.src='${fallbackImage.src}';this.alt=''`}
          />
        ) : (
          <Image
            src={image!}
            alt={imageAlt}
            class="page-stage-image absolute inset-0 !h-full !w-full object-cover"
            style={`object-position: ${imagePosition};`}
            widths={[640, 960, 1280, 1600, 1920]}
            sizes="100vw"
            priority
            format="webp"
            quality={imageQuality}
          />
        )}
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-[linear-gradient(to_bottom,rgba(2,6,23,0.14)_0%,rgba(2,6,23,0.48)_36%,rgba(2,6,23,0.76)_68%,rgb(2,6,23)_100%)]"
        />
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-[linear-gradient(90deg,rgba(2,6,23,0.68)_0%,rgba(2,6,23,0.56)_42rem,transparent_70rem)]"
        />
      </>
    )
  }

  <div class="relative z-10 mx-auto w-full max-w-screen-2xl px-6 md:px-8 lg:px-16">
    <slot name="badge" />
    {
      eyebrow && (
        <p class="mb-6 block font-body text-xs/4 font-semibold uppercase tracking-widest text-role-on/80">{eyebrow}</p>
      )
    }
    <h1
      id="page-hero-heading"
      class:list={[
        'wrap-anywhere font-display text-4xl/tight font-normal tracking-tighter text-white sm:text-5xl/tight md:text-7xl/none lg:text-8xl/none',
        hasImage && 'stage-title'
      ]}
    >
      <span class:list={['block', hasImage ? 'stage-title-text' : 'quiet-title']}><slot /></span>
    </h1>
    {
      subtitle && (
        <p class="mt-6 font-display text-2xl/tight font-normal text-secondary/90 md:text-4xl/tight">
          {subtitle}
        </p>
      )
    }
    {
      intro && (
        <p class="page-hero-intro mt-6 max-w-2xl font-body text-lg/8 text-role-on/85">
          {intro}
        </p>
      )
    }
    {hasCta && (
      <div class="page-hero-actions mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
        <slot name="cta" />
      </div>
    )}
  </div>
</section>
