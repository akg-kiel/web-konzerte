---
import type { ConcertFilters } from '../../data/concerts';

interface Props {
  action: string;
  anchor: string;
  filters: ConcertFilters;
  seasons: string[];
  matchCount: number;
  totalCount: number;
}

const { action, anchor, filters, seasons, matchCount, totalCount } = Astro.props;
const inputClass = 'min-h-12 w-full rounded-sm border border-white/20 bg-midnight/60 px-4 py-3 font-body text-base text-white outline-none transition placeholder:text-role-on/40 focus-visible:border-secondary focus-visible:ring-2 focus-visible:ring-secondary/40';
const hasFilters = Boolean(filters.search || filters.season || filters.from || filters.to);
---

<div class="mt-10 border-t border-white/10 pt-8">
  <form action={`${action}#${anchor}`} method="get" role="search" aria-label="Konzerte filtern">
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      <label class="font-body text-sm/6 font-semibold text-role-on/80 xl:col-span-2">
        Suche
        <input
          class:list={[inputClass, 'mt-2']}
          type="search"
          name="q"
          value={filters.search}
          maxlength="100"
          placeholder="Titel, Programm oder Mitwirkende"
        />
      </label>
      <label class="font-body text-sm/6 font-semibold text-role-on/80">
        Saison
        <select class:list={[inputClass, 'mt-2']} name="season">
          <option value="">Alle Saisons</option>
          {seasons.map((season) => <option value={season} selected={filters.season === season}>Saison {season}</option>)}
        </select>
      </label>
      <div class="grid grid-cols-2 gap-3">
        <label class="font-body text-sm/6 font-semibold text-role-on/80">
          Von
          <input class:list={[inputClass, 'mt-2']} type="date" name="from" value={filters.from} />
        </label>
        <label class="font-body text-sm/6 font-semibold text-role-on/80">
          Bis
          <input class:list={[inputClass, 'mt-2']} type="date" name="to" value={filters.to} />
        </label>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-4">
      <button class="inline-flex min-h-12 items-center justify-center rounded-sm bg-secondary px-6 py-3 font-body text-xs/4 font-semibold uppercase tracking-widest text-midnight transition hover:bg-champagne focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary" type="submit">
        Filtern
      </button>
      {hasFilters && (
        <a class="inline-flex min-h-12 items-center font-body text-xs/4 font-semibold uppercase tracking-widest !text-secondary no-underline hover:!text-champagne focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary" href={`${action}#${anchor}`}>
          Filter zurücksetzen
        </a>
      )}
      <p class="ml-auto font-body text-sm/6 text-role-on/70" aria-live="polite">
        {matchCount} {matchCount === 1 ? 'Konzert' : 'Konzerte'} gefunden{matchCount !== totalCount && ` (von ${totalCount})`}
      </p>
    </div>
  </form>
</div>
