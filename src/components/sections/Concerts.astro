---
import type { Concert, ConcertVariant } from '../../data/concerts';

import ConcertCard from './ConcertCard.astro';

interface Props {
  id?: string;
  concerts?: Concert[];
  variant?: ConcertVariant;
  eyebrow?: string;
  intro?: string;
  emptyMessage?: string;
  showHeaderLink?: boolean;
}

const {
  id = 'naechste-konzerte',
  concerts = [],
  variant = 'home',
  eyebrow = 'Programm',
  intro = '',
  emptyMessage,
  showHeaderLink = variant === 'home'
} = Astro.props;

const titleId = `${id}-heading`;
const isHome = variant === 'home';
const hasConcerts = concerts.length > 0;

const gridClass = 'grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3 lg:gap-8';
const imageSizes = '(min-width: 1024px) 384px, (min-width: 768px) 45vw, calc(100vw - 48px)';

const headerLinkClass =
  'items-center gap-2 font-body text-xs/4 font-semibold uppercase tracking-widest !text-role-on/70 no-underline transition-colors hover:!text-secondary';
---

<section
  id={id}
  aria-labelledby={titleId}
  class:list={[
    'scroll-mt-20',
    isHome
      ? 'bg-midnight px-0 py-16 text-role-on md:py-20'
      : 'bg-midnight px-0 py-24 text-role-on md:py-32',
    variant === 'archive' && 'bg-role-support'
  ]}
>
  <div class="mx-auto w-full max-w-screen-2xl px-6 md:px-8 lg:px-16">
    <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end md:mb-10">
      <div>
        <h2 id={titleId} class="block font-body text-xs/4 font-semibold uppercase tracking-widest text-role-on/60">
          {eyebrow}
        </h2>
        {intro && <p class="mt-6 max-w-2xl font-body text-lg/7 text-role-on/70">{intro}</p>}
      </div>

      {showHeaderLink && (
        <a
          href="/programm"
          class:list={['hidden sm:inline-flex', headerLinkClass]}
        >
          Alle Termine ansehen
          <span aria-hidden="true">→</span>
        </a>
      )}
    </div>

    {
      hasConcerts ? (
        <div class:list={gridClass}>
          {concerts.map((concert) => (
            <ConcertCard concert={concert} imageSizes={imageSizes} variant={variant} />
          ))}
        </div>
      ) : (
        <div class="max-w-2xl">
          <p class="font-body text-sm/6 text-role-on/70">
            {emptyMessage ?? (isHome ? 'Alle aktuellen Termine finden Sie im Konzertprogramm.' : 'Neue Konzerttermine erscheinen hier, sobald sie feststehen.')}
          </p>
        </div>
      )
    }

    {showHeaderLink && (
      <a
        href="/programm"
        class:list={['mt-8 inline-flex sm:hidden', headerLinkClass]}
      >
        Alle Termine ansehen
        <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
</section>
