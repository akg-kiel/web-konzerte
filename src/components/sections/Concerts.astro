---
import { upcomingConcerts } from '../../data/concerts';
import type { Concert, ConcertVariant } from '../../data/concerts';

import ConcertCard from './ConcertCard.astro';

interface Props {
  id?: string;
  concerts?: Concert[];
  variant?: ConcertVariant;
  eyebrow?: string;
  heading?: string;
  intro?: string;
  showHeaderLink?: boolean;
  showFilters?: boolean;
}

const {
  id = 'naechste-konzerte',
  concerts = upcomingConcerts,
  variant = 'home',
  eyebrow = 'Programm',
  heading = 'Nächste Konzerte',
  intro = '',
  showHeaderLink = variant === 'home',
  showFilters = variant === 'programme'
} = Astro.props;

const titleId = `${id}-heading`;
const isHome = variant === 'home';
const isProgramme = variant === 'programme';
const showVisibleHeading = !isHome && Boolean(heading);
const hasConcerts = concerts.length > 0;
const categories = Array.from(new Set(concerts.map((concert) => concert.category)));
const filters = ['Alle', ...categories, 'Eintritt frei'];

const gridClass = isProgramme
  ? 'space-y-6'
  : 'grid grid-cols-1 gap-7 md:grid-cols-2 lg:grid-cols-3 lg:gap-8';

const imageSizes = isProgramme
  ? '(min-width: 768px) 320px, calc(100vw - 40px)'
  : '(min-width: 1024px) 384px, (min-width: 768px) 45vw, calc(100vw - 40px)';

const headerLinkClass =
  'items-center gap-2 font-body text-[12px] font-semibold uppercase leading-4 tracking-[0.1em] !text-role-on/68 no-underline transition-colors hover:!text-secondary';
---

<section
  id={id}
  aria-labelledby={titleId}
  class:list={[
    'scroll-mt-20',
    isHome
      ? 'bg-midnight px-0 py-16 text-role-on md:py-20'
      : 'bg-midnight px-0 py-24 text-role-on md:py-32',
    variant === 'archive' && 'bg-role-support'
  ]}
>
  <div class="site-container">
    {
      showVisibleHeading ? (
        <div class="mb-10 flex flex-col justify-between gap-6 md:mb-12 md:flex-row md:items-end">
          <div>
            <h2 id={titleId} class="section-label">
              {eyebrow}
            </h2>
            {intro && <p class="mt-5 max-w-2xl font-body text-[18px] leading-7 text-role-on/68">{intro}</p>}
          </div>

          {showHeaderLink && (
            <a
              href="/programm"
              class:list={['hidden sm:inline-flex', headerLinkClass]}
              aria-label="Alle Konzerttermine im Programm ansehen"
            >
              Alle Termine ansehen
              <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      ) : (
        <>
          <div class="mb-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between md:mb-10">
            <h2 id={titleId} class="section-label">
              {eyebrow}
            </h2>
            {showHeaderLink && (
              <a
                href="/programm"
                class:list={['hidden sm:inline-flex', headerLinkClass]}
                aria-label="Alle Konzerttermine im Programm ansehen"
              >
                Alle Termine ansehen
                <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </>
      )
    }

    {
      showFilters && hasConcerts && (
        <div aria-label="Programmkategorien" class="-mt-4 mb-10 border-b border-white/5 pb-4">
          <div class="flex flex-wrap items-center gap-3">
            <ul class="flex gap-3 overflow-x-auto pb-1" role="list" data-concert-filters>
              {filters.map((filter, index) => (
                <li>
                  <button
                    type="button"
                    data-filter={filter}
                    class:list={[
                      'inline-flex min-h-10 items-center rounded-sm border px-6 py-2 font-body text-[12px] font-semibold leading-4 tracking-[0.08em] transition-colors',
                      index === 0
                        ? 'border-secondary bg-secondary/10 text-secondary'
                        : 'border-white/20 bg-white/[0.02] text-role-on/78 hover:border-white/40 hover:text-white'
                    ]}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                  >
                    {filter}
                  </button>
                </li>
              ))}
            </ul>
            <span class="ml-auto font-body text-[12px] font-semibold uppercase leading-4 tracking-[0.1em] text-role-on/52" data-concert-count />
          </div>
        </div>
      )
    }

    {
      hasConcerts ? (
        <div class:list={gridClass} data-concert-list>
          {concerts.map((concert) => (
            <ConcertCard concert={concert} imageSizes={imageSizes} variant={variant} data-category={concert.category} data-free={concert.status.state === 'free' ? 'true' : 'false'} />
          ))}
        </div>
      ) : (
        <div class="max-w-2xl">
          <p class="font-body text-sm leading-6 text-role-on/68">
            Neue Konzerttermine erscheinen hier, sobald sie feststehen.
          </p>
        </div>
      )
    }

    {showHeaderLink && (
      <a
        href="/programm"
        class:list={['mt-8 inline-flex sm:hidden', headerLinkClass]}
        aria-label="Alle Konzerttermine im Programm ansehen"
      >
        Alle Termine ansehen
        <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
</section>

<script>
  const filterGroups = document.querySelectorAll<HTMLElement>('[data-concert-filters]');

  filterGroups.forEach((group) => {
    const section = group.closest<HTMLElement>('section');
    const list = section?.querySelector<HTMLElement>('[data-concert-list]');
    const count = section?.querySelector<HTMLElement>('[data-concert-count]');
    if (!section || !list) return;

    const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-category]'));
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const activeClass = ['border-secondary', 'bg-secondary/10', 'text-secondary'];
    const idleClass = ['border-white/20', 'bg-white/[0.02]', 'text-role-on/78', 'hover:border-white/40', 'hover:text-white'];

    const apply = (filter: string) => {
      let visible = 0;
      cards.forEach((card) => {
        const match = filter === 'Alle'
          || card.dataset.category === filter
          || (filter === 'Eintritt frei' && card.dataset.free === 'true');
        card.hidden = !match;
        if (match) visible += 1;
      });
      if (count) count.textContent = `${visible} ${visible === 1 ? 'Konzert' : 'Konzerte'}`;
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.classList.remove(...activeClass);
          b.classList.add(...idleClass);
          b.setAttribute('aria-pressed', 'false');
        });
        button.classList.remove(...idleClass);
        button.classList.add(...activeClass);
        button.setAttribute('aria-pressed', 'true');
        apply(button.dataset.filter ?? 'Alle');
      });
    });

    apply(buttons[0]?.dataset.filter ?? 'Alle');
  });
</script>
