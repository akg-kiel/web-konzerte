---
import { Image } from 'astro:assets';

import type { Concert, ConcertStatusState, ConcertVariant } from '../../data/concerts';

interface Props {
  concert: Concert;
  imageSizes: string;
  variant?: ConcertVariant;
}

const { concert, imageSizes, variant = 'home' } = Astro.props;

const isProgramme = variant === 'programme';
const isArchive = variant === 'archive';
const titleId = `${concert.slug}-title`;

const statusClasses: Record<ConcertStatusState, string> = {
  available: 'border-white/10 bg-white/5 text-role-on/68',
  free: 'border-champagne/20 bg-champagne/10 text-champagne',
  lastTickets: 'border-secondary/45 bg-secondary/15 text-secondary',
  soldOut: 'border-white/15 bg-white/10 text-role-on/70'
};
---

{
  isProgramme ? (
    <article
      aria-labelledby={titleId}
      class:list={[
        'group group/card relative flex flex-col overflow-hidden rounded-[0.5rem] border border-white/5 bg-slate-mist/30 transition-colors duration-300 hover:border-secondary/30 md:flex-row',
        isArchive && 'opacity-75 grayscale-[0.25]'
      ]}
    >
      <div class="relative min-h-64 overflow-hidden md:w-[34%] lg:w-[31%]">
        <Image
          src={concert.image}
          alt={concert.imageAlt}
          class="absolute inset-0 !h-full !w-full !object-cover"
          style={`object-position: ${concert.imagePosition};`}
          widths={[480, 720, 960]}
          sizes={imageSizes}
          loading="lazy"
          decoding="async"
          format="webp"
        />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgb(var(--color-midnight-rgb)/0.1),rgb(var(--color-midnight-rgb)/0.42))]" aria-hidden="true"></div>
        <time
          datetime={concert.date.iso}
          class="absolute left-4 top-4 flex flex-col items-center rounded-sm border border-white/10 bg-midnight/80 px-3 py-2 font-body backdrop-blur-md"
        >
          <span class="mb-1 text-[12px] font-semibold uppercase leading-4 tracking-[0.1em] text-secondary">
            {concert.date.month}
          </span>
          <span class="font-display text-4xl leading-none tracking-[-0.04em] text-role-on">
            {concert.date.day}
          </span>
          <span class="mt-1 text-sm leading-5 text-role-on/78">{concert.date.time}</span>
        </time>
      </div>

      <div class="flex min-h-full min-w-0 flex-1 flex-col px-6 py-7 md:px-8 lg:px-10">
        <div class="flex flex-wrap items-center gap-3">
          <span class="rounded-sm border border-white/10 bg-white/5 px-3 py-1 font-body text-[11px] font-semibold uppercase leading-4 tracking-[0.1em] text-role-on/72">
            {concert.category}
          </span>
          <span class="font-body text-lg leading-6 text-secondary">{concert.price}</span>
          {concert.status.state !== 'available' && (
            <span class:list={['rounded-sm border px-3 py-1 font-body text-[11px] font-semibold uppercase leading-4 tracking-[0.08em]', statusClasses[concert.status.state]]}>
              {concert.status.label}
            </span>
          )}
        </div>

        <h3
          id={titleId}
          title={concert.title}
          tabindex="0"
          class="group/title relative mt-5 block max-w-full overflow-hidden font-display !text-[clamp(1.6rem,3vw,2.35rem)] !font-normal !leading-[1.08] tracking-[-0.03em] !text-role-on/92 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary/70 group-hover:!text-white"
          data-concert-title
          data-overflow="false"
        >
          <span class="block truncate pr-6 !text-nowrap transition-opacity motion-reduce:!opacity-100 group-data-[overflow=true]/title:group-hover/card:opacity-0 group-data-[overflow=true]/title:group-focus-within/title:opacity-0" data-concert-title-text>
            {concert.title}
          </span>
          <span aria-hidden="true" class="pointer-events-none absolute inset-0 hidden overflow-hidden motion-reduce:!hidden group-data-[overflow=true]/title:group-hover/card:block group-data-[overflow=true]/title:group-focus-within/title:block">
            <span class="inline-flex min-w-max animate-title-marquee gap-10 pr-10 motion-reduce:animate-none">
              <span>{concert.title}</span>
              <span>{concert.title}</span>
            </span>
          </span>
        </h3>
        <p class="!mt-3 !mb-5 max-w-none font-body text-base leading-7 text-role-on/72 md:text-lg md:leading-8">
          {concert.programme}
        </p>

        <dl class="mt-0 grid gap-2 border-t border-white/10 pt-5 font-body text-sm leading-6 text-role-on/64 sm:grid-cols-2">
          <div>
            <dt class="sr-only">Mitwirkende</dt>
            <dd>{concert.performers}</dd>
          </div>
          <div>
            <dt class="sr-only">Ort</dt>
            <dd>{concert.location}</dd>
          </div>
        </dl>

        <div class="mt-7 flex justify-end border-t border-white/10 pt-5">
          <div class="flex flex-wrap justify-end gap-2">
            <a
              href={concert.detailsHref}
              class="inline-flex min-h-11 min-w-28 items-center justify-center rounded-sm border border-white/20 bg-transparent px-5 py-2.5 font-body text-[12px] font-semibold uppercase leading-4 tracking-[0.08em] !text-role-on/84 no-underline transition-colors hover:border-white/45 hover:bg-white/[0.04] hover:!text-white active:scale-95"
              aria-label={`Details zu ${concert.title} ansehen`}
            >
              Details
            </a>
            {concert.ticketUrl && (
              <a
                href={concert.ticketUrl}
                class="inline-flex min-h-11 min-w-28 items-center justify-center rounded-sm border border-secondary/55 bg-transparent px-5 py-2.5 font-body text-[12px] font-semibold uppercase leading-4 tracking-[0.08em] !text-secondary no-underline transition-colors hover:border-secondary hover:bg-secondary/10 hover:!text-champagne active:scale-95"
                aria-label={`Tickets für ${concert.title} kaufen`}
              >
                {concert.ticketLabel}
              </a>
            )}
          </div>
        </div>
      </div>
    </article>
  ) : (
    <article
      aria-labelledby={titleId}
      class:list={[
        'group group/card relative flex h-full flex-col overflow-hidden rounded-[0.5rem] border border-white/10 bg-slate-mist/60 backdrop-blur-[12px] transition-colors duration-300 hover:border-secondary/40',
        isArchive && 'opacity-75 grayscale-[0.25]'
      ]}
    >
      <div class="relative aspect-[4/3] w-full shrink-0 overflow-hidden">
        <Image
          src={concert.image}
          alt={concert.imageAlt}
          class="absolute inset-0 !h-full !w-full !object-cover"
          style={`object-position: ${concert.imagePosition};`}
          widths={[480, 720, 960]}
          sizes={imageSizes}
          loading="lazy"
          decoding="async"
          format="webp"
        />
        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(var(--color-midnight-rgb)/0),rgb(var(--color-midnight-rgb)/0.12))]" aria-hidden="true"></div>
      </div>

      <div class="flex min-w-0 flex-grow flex-col px-7 pb-7 pt-6">
        <div class="mb-4 flex items-center gap-2 font-body text-[12px] font-semibold uppercase leading-4 tracking-[0.1em] text-secondary">
          <svg aria-hidden="true" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none">
            <path d="M7 3v3M17 3v3M4.5 9.5h15M6.5 5h11A2.5 2.5 0 0 1 20 7.5v10A2.5 2.5 0 0 1 17.5 20h-11A2.5 2.5 0 0 1 4 17.5v-10A2.5 2.5 0 0 1 6.5 5Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
          </svg>
          <time datetime={concert.date.iso}>{concert.date.display}</time>
        </div>

        <h3
          id={titleId}
          title={concert.title}
          tabindex="0"
          class="group/title relative mb-3 block max-w-full overflow-hidden font-display !text-[20px] !font-normal !leading-[1.32] tracking-[-0.01em] !text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary/70 sm:!text-[21px]"
          data-concert-title
          data-overflow="false"
        >
          <span class="block truncate pr-6 !text-nowrap transition-opacity motion-reduce:!opacity-100 group-data-[overflow=true]/title:group-hover/card:opacity-0 group-data-[overflow=true]/title:group-focus-within/title:opacity-0" data-concert-title-text>
            {concert.title}
          </span>
          <span aria-hidden="true" class="pointer-events-none absolute inset-0 hidden overflow-hidden motion-reduce:!hidden group-data-[overflow=true]/title:group-hover/card:block group-data-[overflow=true]/title:group-focus-within/title:block">
            <span class="inline-flex min-w-max animate-title-marquee gap-10 pr-10 motion-reduce:animate-none">
              <span>{concert.title}</span>
              <span>{concert.title}</span>
            </span>
          </span>
        </h3>
        <p class="!mb-5 min-h-[4.65rem] max-w-none overflow-hidden font-body text-[15px] leading-[1.55] text-role-on/68 [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:3] sm:text-[16px]">
          {concert.programme}
        </p>
        <span class="sr-only">
          Mitwirkende: {concert.performers}. Ort: {concert.location}. Status: {concert.status.label}.
        </span>

        <div class="mt-0 flex items-center justify-end border-t border-white/10 pt-5">
          <div class="flex flex-wrap justify-end gap-2">
            <a
              href={concert.detailsHref}
              class="inline-flex min-h-10 items-center justify-center rounded-sm border border-white/18 bg-transparent px-4 py-2 font-body text-[11px] font-semibold uppercase leading-4 tracking-[0.09em] !text-role-on/72 no-underline transition-colors hover:border-white/40 hover:bg-white/[0.04] hover:!text-white active:scale-95"
              aria-label={`Details zu ${concert.title} ansehen`}
            >
              Details
            </a>
            {concert.ticketUrl && (
              <a
                href={concert.ticketUrl}
                class="inline-flex min-h-10 items-center justify-center rounded-sm border border-secondary/55 bg-transparent px-4 py-2 font-body text-[11px] font-semibold uppercase leading-4 tracking-[0.09em] !text-secondary no-underline transition-colors hover:border-secondary hover:bg-secondary/10 hover:!text-champagne active:scale-95"
                aria-label={`Tickets für ${concert.title} kaufen`}
              >
                {concert.ticketLabel}
              </a>
            )}
          </div>
        </div>
      </div>
    </article>
  )
}

<script>
  const concertTitleSelector = '[data-concert-title]';
  let concertTitleFrame = 0;

  const updateAllConcertTitleOverflow = () => {
    globalThis.document.querySelectorAll(concertTitleSelector).forEach((title) => {
      if (!(title instanceof globalThis.HTMLElement)) return;

      const text = title.querySelector('[data-concert-title-text]');
      const hasOverflow = text instanceof globalThis.HTMLElement && text.scrollWidth - text.clientWidth > 1;
      title.dataset.overflow = hasOverflow ? 'true' : 'false';
    });
  };

  const scheduleConcertTitleOverflowUpdate = () => {
    if (concertTitleFrame) return;

    concertTitleFrame = globalThis.requestAnimationFrame(() => {
      concertTitleFrame = 0;
      updateAllConcertTitleOverflow();
    });
  };

  updateAllConcertTitleOverflow();
  globalThis.document.fonts?.ready.then(scheduleConcertTitleOverflowUpdate);
  globalThis.addEventListener('resize', scheduleConcertTitleOverflowUpdate, { passive: true });

  if ('ResizeObserver' in globalThis) {
    const titleResizeObserver = new globalThis.ResizeObserver(scheduleConcertTitleOverflowUpdate);
    globalThis.document.querySelectorAll(concertTitleSelector).forEach((title) => {
      if (title instanceof globalThis.HTMLElement) titleResizeObserver.observe(title);
    });
  }
</script>

