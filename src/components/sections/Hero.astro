---
import { Image } from 'astro:assets';

import heroStage from '../../assets/hero/l1130722-hero.jpg';
---

<section
  aria-labelledby="hero-heading"
  class="relative flex min-h-[100svh] items-end overflow-hidden bg-role-dominant px-0 pb-[calc(3.5rem+env(safe-area-inset-bottom))] pt-24 text-role-on sm:pb-20 md:pb-44 lg:pb-22"
>
  <div class="absolute inset-x-0 top-0 bottom-[40svh] z-0 w-full overflow-hidden md:bottom-[10svh]">
    <Image
      src={heroStage}
      alt=""
      class="h-full w-full object-cover object-[75%_center]"
      widths={[640, 960, 1280, 1600, 1920]}
      sizes="100vw"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      format="webp"
    />
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-[linear-gradient(to_bottom,rgba(2,6,23,0.04)_0%,rgba(2,6,23,0.08)_46%,rgba(2,6,23,0.3)_70%,rgba(2,6,23,0.72)_100%)] md:bg-[linear-gradient(to_bottom,rgba(2,6,23,0.02)_0%,rgba(2,6,23,0.04)_58%,rgba(2,6,23,0.18)_82%,rgba(2,6,23,0.68)_100%)]"
    >
    </div>
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-[linear-gradient(90deg,rgba(2,6,23,0.36)_0%,rgba(2,6,23,0.1)_46%,rgba(2,6,23,0.18)_100%)] md:bg-[linear-gradient(90deg,rgba(2,6,23,0.22)_0%,rgba(2,6,23,0.05)_46%,rgba(2,6,23,0.14)_100%)]"
    >
    </div>
    <div
      aria-hidden="true"
      class="absolute inset-x-0 bottom-0 h-[62%] bg-[linear-gradient(to_bottom,rgba(2,6,23,0)_0%,rgba(2,6,23,0.16)_32%,rgba(2,6,23,0.54)_70%,rgb(2,6,23)_100%)] md:h-[42%] md:bg-[linear-gradient(to_bottom,rgba(2,6,23,0)_0%,rgba(2,6,23,0.12)_42%,rgba(2,6,23,0.55)_82%,rgb(2,6,23)_100%)] lg:h-[36%]"
    >
    </div>
    <div
      aria-hidden="true"
      class="absolute inset-y-0 left-0 w-[76%] bg-[radial-gradient(ellipse_at_24%_86%,rgba(2,6,23,0.72)_0%,rgba(2,6,23,0.42)_32%,rgba(2,6,23,0.08)_58%,rgba(2,6,23,0)_76%)] md:w-[62%] lg:w-[54%]"
    >
    </div>
  </div>

  <div class="relative z-20 mx-auto w-full max-w-screen-2xl px-6 md:px-8 lg:px-16">
    <div class="max-w-3xl">
      <h1 id="hero-heading" class="font-display text-4xl/tight font-semibold tracking-tight !text-white sm:text-5xl/tight md:text-7xl/tight lg:text-8xl/tight">
        <span class="block sm:whitespace-nowrap">Konzerte in der</span>
        <span class="block italic !text-secondary">Petruskirche Kiel</span>
      </h1>

      <p class="mt-6 max-w-md font-body text-sm/relaxed font-normal tracking-tight text-role-on/70 md:max-w-xl md:text-base/relaxed md:text-role-on/75">
        Ein besonderer Konzertort in Kiel-Wik für Klassik, Chor, Pop, Crossover und
        Kulturveranstaltungen. Erleben Sie Musik in unvergleichlicher akustischer und
        architektonischer Atmosphäre.
      </p>

      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a
          class="inline-flex min-h-14 items-center justify-center rounded-sm bg-secondary px-8 py-4 font-body text-xs/4 font-semibold uppercase tracking-widest !text-midnight no-underline transition hover:bg-role-accent active:scale-95"
          href="#naechste-konzerte"
          aria-label="Zu den nächsten Konzerten springen"
        >
          Programm ansehen
        </a>
        <a
          class="inline-flex min-h-14 items-center justify-center rounded-sm border border-white/10 bg-slate-mist/60 px-8 py-4 font-body text-xs/4 font-semibold uppercase tracking-widest !text-white no-underline shadow-sm backdrop-blur-xl transition hover:bg-white/10 active:scale-95"
          href="/besuch-planen"
          aria-label="Besuch in der Petruskirche planen"
        >
          Besuch planen
        </a>
      </div>
    </div>
  </div>
</section>
