---
import { getImage, Image } from 'astro:assets';

import heroStage from '../../assets/hero/l1130722-hero.jpg';
import { ButtonLink } from '../ui/button';

const widths = [640, 960, 1280, 1600, 1920];
const avif = await getImage({
  src: heroStage,
  widths,
  format: 'avif',
  quality: 50
});
---

<section
  aria-labelledby="hero-heading"
  class="relative flex min-h-[100svh] items-end overflow-hidden bg-role-dominant px-0 pb-[calc(3.5rem+env(safe-area-inset-bottom))] pt-24 text-role-on sm:pb-20 md:pb-44 lg:pb-22"
>
  <div class="hero-stage absolute inset-x-0 top-0 bottom-[22svh] z-0 w-full overflow-hidden md:bottom-[10svh]">
    <picture class="contents">
      <source type="image/avif" srcset={avif.srcSet.attribute} sizes="100vw" />
      <Image
        src={heroStage}
        alt=""
        class="hero-stage-image h-full w-full object-cover object-[75%_center]"
        widths={widths}
        sizes="100vw"
        priority
        format="webp"
        quality={70}
      />
    </picture>
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-[linear-gradient(to_bottom,transparent_28%,rgba(2,6,23,0.18)_52%,rgba(2,6,23,0.76)_84%,var(--color-midnight)_100%)]"
    ></div>
    <div
      aria-hidden="true"
      class="absolute inset-0 hidden bg-[linear-gradient(to_right,rgba(2,6,23,0.76)_0%,rgba(2,6,23,0.64)_max(48rem,54%),transparent_max(74rem,85%))] md:block"
    ></div>
  </div>

  <div class="relative z-20 mx-auto w-full max-w-screen-2xl px-6 md:px-8 lg:px-16">
    <!-- On short screens or with enlarged text, the title can move well above the stage's lower fade. -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 -bottom-16 -z-10 bg-[linear-gradient(to_bottom,transparent,rgba(2,6,23,0.72)_5rem)] md:hidden"></div>
    <div class="max-w-3xl">
      <h1 id="hero-heading" class="font-hero wrap-anywhere text-4xl/tight font-semibold tracking-tight !text-white sm:text-5xl/tight md:text-7xl/tight lg:text-8xl/tight">
        <span class="hero-title-line block"><span class="hero-title-word block">Konzerte in der</span></span>
        <span class="hero-title-line block italic !text-secondary"><span class="hero-title-word hero-title-accent block">Petruskirche Kiel</span></span>
      </h1>

      <p class="hero-intro mt-6 max-w-md font-body text-lg/7 text-role-on">
        Klassik, Chor, Pop und Crossover in der Kieler Wik.
      </p>

      <div class="hero-actions mt-8 flex flex-wrap items-center gap-x-6 gap-y-2">
        <ButtonLink
          className="h-auto min-h-12 max-w-full whitespace-normal rounded-sm bg-secondary px-6 py-2 text-center font-body text-sm/6 font-semibold text-midnight hover:bg-champagne"
          href="#naechste-konzerte"
        >
          Nächste Konzerte
        </ButtonLink>
        <a class="inline-flex min-h-12 items-center font-body text-sm/6 font-semibold text-white underline underline-offset-4 hover:text-champagne" href="/besuch-planen/">
          Besuch planen
        </a>
      </div>
    </div>
  </div>
</section>
