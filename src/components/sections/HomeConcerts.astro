---
import { env } from 'cloudflare:workers';

import { getConcerts, splitConcerts } from '../../data/concerts';
import Concerts from './Concerts.astro';

const result = await getConcerts(env);
const { programmeConcerts } = splitConcerts(result.concerts);
---

<Concerts
  concerts={programmeConcerts.slice(0, 3)}
  emptyMessage={result.error ? 'Das aktuelle Konzertprogramm konnte gerade nicht geladen werden. Bitte versuchen Sie es später erneut.' : undefined}
/>
