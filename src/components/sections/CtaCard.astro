---
import Card from '../ui/Card.astro';

interface Props {
  href: string;
  title: string;
  body: string;
}

const { href, title, body } = Astro.props;
---

<Card
  as="a"
  href={href}
  aria-label={title}
  class="cta-card group block p-6 !text-role-on no-underline transition-colors hover:border-secondary/40 focus-visible:border-secondary/50 md:p-8"
>
  <h3 class="flex items-center justify-between gap-4 wrap-anywhere font-display text-2xl/8 font-normal text-white group-hover:text-champagne group-focus-visible:text-champagne md:text-3xl/9">
    {title}
    <svg class="cta-arrow size-6 shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M4 12h15m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </h3>
  <p class="mt-4 max-w-lg font-body text-base/7 text-role-on/80">{body}</p>
</Card>
