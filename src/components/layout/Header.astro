---
import { Image } from 'astro:assets';

import akgLogo from '../../assets/logos/logo-akg-250px.png';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { label: 'Programm', href: '/programm', match: '/programm' },
  { label: 'Besuch planen', href: '/besuch-planen', match: '/besuch-planen' },
  {
    label: 'Die Petruskirche',
    href: 'https://akg-kiel.de/petruskirche',
    external: true,
    match: ''
  },
  { label: 'Raum anfragen', href: '/raum-anfragen', match: '/raum-anfragen' },
  { label: 'Kontakt', href: 'mailto:kontakt@akg-kiel.de', match: '' }
];

const isActive = (match: string) => Boolean(match) && (pathname === match || pathname.startsWith(`${match}/`));
---

<nav aria-label="Hauptnavigation" class="fixed inset-x-0 top-0 z-50 border-b border-white/10 shadow-sm">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-slate-mist/60 backdrop-blur-xl"></div>
  <div class="site-container relative flex h-20 items-center gap-6">
    <a
      href="/"
      class="relative z-[60] inline-flex items-center no-underline transition hover:opacity-85"
      aria-label="Apostel Kirchengemeinde Kiel · Konzertkirche Petruskirche Startseite"
    >
      <Image
        src={akgLogo}
        alt="Apostel Kirchengemeinde Kiel"
        class="h-10 w-auto brightness-0 invert sm:h-12"
        widths={[160, 220, 250]}
        sizes="(min-width: 640px) 113px, 94px"
        loading="eager"
        decoding="async"
      />
    </a>

    <div class="ml-auto hidden items-center gap-8 font-body text-[12px] font-semibold uppercase leading-4 tracking-[0.1em] md:flex">
      {
        navItems.map((item) => {
          const active = isActive(item.match);
          return (
            <a
              class:list={[
                active
                  ? 'border-b-2 border-secondary pb-1 text-secondary no-underline'
                  : 'text-role-on/78 no-underline transition hover:text-secondary'
              ]}
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </div>

    <details class="mobile-nav ml-auto md:hidden">
      <summary class="mobile-nav__toggle" aria-label="Navigation öffnen oder schließen">
        <span class="sr-only">Navigation öffnen oder schließen</span>
        <span class="mobile-nav__icon"></span>
      </summary>
      <div class="mobile-nav__panel">
        <div class="site-container flex min-h-svh flex-col pb-10 pt-32">
          <p class="font-body text-[11px] font-semibold uppercase leading-4 tracking-[0.18em] text-secondary/80">
            Menü
          </p>

          <div class="mt-10 flex flex-col gap-5 font-display text-[clamp(2.05rem,10.5vw,3.6rem)] leading-[1.02] tracking-[-0.035em]">
            {
              navItems.map((item) => (
                <a
                  class:list={['mobile-nav__link', isActive(item.match) && 'text-secondary']}
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                  aria-current={isActive(item.match) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </div>

          <p class="mt-auto max-w-xs border-t border-white/10 pt-6 font-body text-sm leading-6 text-role-on/58">
            Tickets werden über externe Anbieter verkauft.
          </p>
        </div>
      </div>
    </details>
  </div>
</nav>
