<nav data-page-seeker hidden aria-label="Abschnitte dieser Seite" class="group/seeker fixed right-2 top-1/2 z-30 hidden -translate-y-1/2 rounded-lg bg-midnight py-2 shadow-panel lg:block print:hidden">
  <ol class="flex flex-col"></ol>
</nav>

<style>
  @media (height < 40rem) {
    [data-page-seeker] { display: none; }
  }
</style>

<script>
  let cleanup = () => {};
  const enhanceSeeker = () => {
    cleanup();
    const nav = document.querySelector<HTMLElement>('[data-page-seeker]');
    const list = nav?.querySelector('ol');
    const main = document.querySelector('main');
    const top = document.getElementById('page-content');
    if (!nav || !list || !main || !top) return;

    let sections: { target: HTMLElement; label: string }[] = [];
    let links: HTMLAnchorElement[] = [];
    let signature = '';
    let frame = 0;
    let needsRefresh = true;
    const collect = () => {
      const names = new Map([...main.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]')]
        .map(link => [link.hash, link.textContent?.trim() ?? '']));
      const seen = new Set([top.id]);
      sections = [{ target: top, label: 'Seitenanfang' }];
      for (const heading of main.querySelectorAll<HTMLElement>('h2[id]')) {
        const section = heading.closest<HTMLElement>('section[aria-labelledby]');
        if (!section?.getAttribute('aria-labelledby')?.split(/\s+/).includes(heading.id) ||
            heading.closest('[hidden], [inert], dialog, nav') || !heading.getClientRects().length) continue;
        const target = section.id ? section : heading;
        const label = names.get('#' + target.id) || heading.textContent?.trim().replace(/\s+/g, ' ');
        if (!label || seen.has(target.id)) continue;
        seen.add(target.id);
        sections.push({ target, label });
      }
      // Replace stale island references without rebuilding unchanged links or losing focus.
      const nextSignature = JSON.stringify(sections.map(({ target, label }) => [target.id, label]));
      if (signature === nextSignature) return;
      signature = nextSignature;
      const focused = links.find(link => link === document.activeElement)?.hash;
      list.replaceChildren();
      links = sections.map(({ target, label }) => {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = '#' + encodeURIComponent(target.id);
        link.setAttribute('aria-label', label);
        link.title = label;
        link.className = 'group/link relative flex h-8 w-12 items-center justify-center text-role-on/70 no-underline hover:text-champagne aria-[current=location]:text-secondary';
        const mark = document.createElement('span');
        mark.setAttribute('aria-hidden', 'true');
        mark.className = 'h-px w-8 origin-right scale-x-50 bg-current transition-transform group-hover/link:scale-x-75 group-aria-[current=location]/link:scale-x-100 motion-reduce:transition-none';
        const text = document.createElement('span');
        text.textContent = label;
        text.setAttribute('aria-hidden', 'true');
        text.className = 'pointer-events-none absolute right-full h-8 w-64 truncate rounded-l-sm bg-midnight px-4 text-right font-body text-sm/8 opacity-0 transition-opacity group-hover/seeker:pointer-events-auto group-hover/seeker:opacity-100 group-focus-within/seeker:pointer-events-auto group-focus-within/seeker:opacity-100 motion-reduce:transition-none';
        link.appendChild(mark);
        link.appendChild(text);
        item.appendChild(link);
        list.appendChild(item);
        return link;
      });
      if (focused) (links.find(link => link.hash === focused) ?? links[0])?.focus({ preventScroll: true });
    };
    const update = () => {
      frame = 0;
      if (needsRefresh) { needsRefresh = false; collect(); }
      const maxScroll = Math.max(0, document.documentElement.scrollHeight - innerHeight);
      nav.hidden = sections.length < 2 || maxScroll === 0;
      if (nav.hidden) return;
      // Leave room for the fixed header and never offer off-screen controls.
      if (nav.getBoundingClientRect().height > innerHeight - 160) { nav.hidden = true; return; }
      const offset = parseFloat(getComputedStyle(document.documentElement).fontSize) * 6;
      const positions = sections.map(({ target }) => {
        const y = target.getBoundingClientRect().top + scrollY;
        const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || offset;
        return { y, landing: Math.max(0, Math.min(maxScroll, y - margin)) };
      });
      // Match native anchor landings, including short final sections and parallel columns.
      let current = 0;
      positions.forEach(({ y, landing }, index) => {
        if (landing <= scrollY + 2 && (landing > positions[current].landing ||
            (landing === positions[current].landing && y > positions[current].y))) current = index;
      });
      const anchored = links.findIndex(link => link.hash === location.hash);
      if (anchored >= 0 && Math.abs(positions[anchored].landing - scrollY) <= 2) current = anchored;
      links.forEach((link, index) => {
        if (index === current) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    const refresh = () => { needsRefresh = true; schedule(); };
    const mutations = new MutationObserver(refresh);
    mutations.observe(main, { childList: true, subtree: true, characterData: true,
      attributes: true, attributeFilter: ['hidden', 'inert', 'id', 'aria-labelledby'] });
    const resize = new ResizeObserver(refresh);
    resize.observe(main);
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('hashchange', schedule);
    window.addEventListener('resize', refresh);
    window.addEventListener('pageshow', refresh);
    main.addEventListener('load', refresh, true);
    update();
    cleanup = () => {
      mutations.disconnect();
      resize.disconnect();
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('hashchange', schedule);
      window.removeEventListener('resize', refresh);
      window.removeEventListener('pageshow', refresh);
      main.removeEventListener('load', refresh, true);
      cancelAnimationFrame(frame);
    };
  };
  enhanceSeeker();
  document.addEventListener('astro:before-swap', () => cleanup());
  document.addEventListener('astro:page-load', enhanceSeeker);
</script>
