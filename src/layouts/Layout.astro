---
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = 'Kieler Konzertkirche · Konzerte in der Petruskirche',
  description = 'Konzerte in der Petruskirche Kiel: klassische Musik, Raumklang und besondere Programme in architektonischer Atmosphäre.',
  ogImage = '/og-image.jpg',
  canonicalUrl
} = Astro.props;

const siteName = 'Kieler Konzertkirche';
const siteUrl = Astro.site ?? Astro.url;
const currentUrl = new URL(Astro.url.pathname, siteUrl);
const canonicalHref = canonicalUrl ?? currentUrl.href;
const ogImageUrl = new URL(ogImage, siteUrl).href;
---

<!doctype html>
<html lang="de" dir="ltr" class="min-h-full overflow-x-clip scroll-smooth bg-midnight scheme-dark motion-reduce:scroll-auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={siteName} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalHref} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#020617" />

    <link
      rel="preload"
      href="/fonts/hanken-grotesk-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/merriweather-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/merriweather-latin-wght-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="de_DE" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{title}</title>

    <script is:inline type="application/ld+json">
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteName,
        url: siteUrl.href,
        description,
        inLanguage: 'de'
      })}
    </script>
  </head>
  <body class="min-h-screen min-w-80 overflow-x-clip bg-midnight font-body text-base/relaxed text-role-on antialiased selection:bg-champagne selection:text-midnight [&_*:focus-visible]:outline [&_*:focus-visible]:outline-2 [&_*:focus-visible]:outline-offset-4 [&_*:focus-visible]:outline-champagne">
    <a href="#page-content" class="fixed left-4 top-4 z-50 -translate-y-24 rounded-full bg-champagne px-4 py-2 text-midnight shadow-glow transition-transform focus-visible:translate-y-0">Direkt zum Inhalt springen</a>
    <Header />
    <div id="page-content" class="min-h-screen" tabindex="-1">
      <slot />
    </div>
    <Footer />
  </body>
</html>
