---
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import PageMetadata from '../components/layout/PageMetadata.astro';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  clientNavigation?: boolean;
}

const {
  title,
  description,
  ogImage,
  canonicalUrl,
  noindex,
  clientNavigation = false
} = Astro.props;
---

<!doctype html>
<html
  lang="de"
  dir="ltr"
  transition:animate={clientNavigation ? 'none' : undefined}
  class:list={[
    'min-h-full overflow-x-clip bg-midnight scheme-dark motion-reduce:scroll-auto',
    clientNavigation ? 'scroll-auto' : 'scroll-smooth'
  ]}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <PageMetadata {title} {description} {ogImage} {canonicalUrl} {noindex} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#020617" />

    <link
      rel="preload"
      href="/fonts/hanken-grotesk-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/merriweather-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/merriweather-latin-wght-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <slot name="head" />
  </head>
  <body class="min-h-screen min-w-80 overflow-x-clip bg-midnight font-body text-base/relaxed text-role-on antialiased selection:bg-champagne selection:text-midnight [&_*:focus-visible]:outline [&_*:focus-visible]:outline-2 [&_*:focus-visible]:outline-offset-4 [&_*:focus-visible]:outline-champagne">
    <a href="#page-content" class="fixed left-4 top-4 z-50 -translate-y-24 rounded-full bg-champagne px-4 py-2 text-midnight shadow-glow transition-transform focus-visible:translate-y-0">Direkt zum Inhalt springen</a>
    <Header preparedProgramme={clientNavigation} />
    <div id="page-content" class="min-h-screen" tabindex="-1">
      <slot />
    </div>
    <Footer preparedProgramme={clientNavigation} />
    <script>
      import '../scripts/scroll-reveal';
    </script>
  </body>
</html>
