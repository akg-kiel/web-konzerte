---
import { Image } from 'astro:assets';

import Concerts from '../components/sections/Concerts.astro';
import CtaCard from '../components/sections/CtaCard.astro';
import Hero from '../components/sections/Hero.astro';
import Card from '../components/ui/Card.astro';
import Layout from '../layouts/Layout.astro';
import churchExterior from '../assets/venue/petruskirche-exterior.webp';
import acousticReflection from '../assets/venue/petruskirche-interior-concert.webp';
---

<Layout title="Konzerte in der Petruskirche Kiel" description="Konzertkirche Petruskirche Kiel: Programm, Besuchsplanung und Raum für Kulturveranstaltungen in besonderer Akustik.">
  <main class="min-h-screen bg-role-dominant text-role-on">
    <Hero />
    <Concerts />

    <section class="py-16 md:py-44" aria-label="Zitat über Musik">
      <div class="mx-auto flex w-full max-w-3xl flex-col items-center px-5 text-center md:px-8">
        <blockquote class="max-w-none text-center font-display text-[clamp(1.45rem,4vw,2.65rem)] font-normal italic leading-[1.18] tracking-[-0.025em] text-white">
          Musik drückt das aus, was nicht gesagt werden kann und worüber zu schweigen unmöglich ist.
        </blockquote>
        <div class="mt-6 inline-flex items-center justify-center gap-3 text-center">
          <span class="h-px w-6 bg-secondary/25" aria-hidden="true"></span>
          <cite class="block text-center font-body text-[10px] font-semibold uppercase not-italic leading-4 tracking-[0.16em] text-secondary">Victor Hugo</cite>
          <span class="h-px w-6 bg-secondary/25" aria-hidden="true"></span>
        </div>
      </div>
    </section>

    <section class="architecture-section relative overflow-hidden border-y border-white/5 bg-surface py-16 md:py-24 lg:py-32" aria-labelledby="architecture-heading">
      <div class="architecture-radial-field pointer-events-none absolute" aria-hidden="true"></div>
      <div class="site-container relative grid grid-cols-1 items-center gap-10 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] md:gap-12 lg:gap-16">
        <div class="order-2 md:order-1">
          <h2 id="architecture-heading" class="section-label">Architektur &amp; Raumklang</h2>
          <div class="mt-6 grid max-w-2xl gap-5 font-body text-base leading-7 text-role-on/72 md:max-w-none md:text-lg md:leading-8">
            <p>
              Die Petruskirche in Kiel-Wik besticht nicht nur durch ihre neugotische Architektur, sondern vor allem durch eine Akustik, die Stimmen, Orgel und Ensembleklang besonders klar trägt.
            </p>
            <p>
              Der weite Kirchenraum bietet mit seinen hohen Gewölben den Resonanzkörper für orchestrale Werke, während die intime Atmosphäre des Altarraums kammermusikalischen Darbietungen einen besonderen Rahmen verleiht.
            </p>
          </div>
        </div>
        <div class="order-1 md:order-2">
          <Card as="figure" class="architecture-media__front bg-slate-mist/30 shadow-panel aspect-[4/5]">
            <Image
              src={churchExterior}
              alt="Außenansicht der Petruskirche Kiel mit neugotischer Backsteinarchitektur"
              class="object-cover object-[50%_42%]"
              widths={[480, 640, 960]}
              loading="lazy"
              decoding="async"
            />
          </Card>
        </div>
      </div>
    </section>

    <section class="bg-midnight py-20 md:py-32" aria-labelledby="service-heading">
      <div class="site-container">
        <div class="mb-8 max-w-3xl md:mb-10">
          <h2 id="service-heading" class="section-label">Ihren Besuch &amp; Events planen</h2>
        </div>
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          <CtaCard
            href="/besuch-planen"
            icon="i"
            title="Besuch planen"
            body="Alles Wichtige für Ihren Konzertbesuch: Anfahrt, Parkmöglichkeiten in der Kieler Wik sowie Informationen zur Barrierefreiheit und zum Café Dreimaster."
            cta="Besucherinfos ansehen"
          />

          <CtaCard
            href="/raum-anfragen"
            icon="◇"
            title="Raum anfragen"
            body="Sie möchten die Petruskirche für eigene Kulturveranstaltungen, Konzerte oder Aufnahmen nutzen? Informieren Sie sich über Technik, Akustik und Konditionen."
            cta="Jetzt unverbindlich anfragen"
          />
        </div>
      </div>
    </section>
  </main>
</Layout>
