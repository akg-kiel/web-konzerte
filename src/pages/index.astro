---
import Layout from '../layouts/Layout.astro';
import Counter from '../components/ui/Counter';
---

<Layout title="Konzerte in der Petruskirche">
  <main class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100">
    <div class="text-center p-8 space-y-8">
      <div>
        <h1 class="text-4xl font-bold text-gray-900 mb-4">
          Konzerte in der Petruskirche
        </h1>
        <p class="text-xl text-gray-700">
          Willkommen auf der Konzertseite der Petruskirche
        </p>
        <p class="mt-4 text-sm text-gray-500">
          Astro + React + Tailwind CSS erfolgreich konfiguriert! 🎉
        </p>
      </div>

      <div class="flex justify-center">
        <Counter client:load />
      </div>

      <p class="text-xs text-gray-400">
        React Counter Component mit client:load Direktive
      </p>
    </div>
  </main>
</Layout>
