---
import { env } from 'cloudflare:workers';
import { Image } from 'astro:assets';

import Concerts from '../components/sections/Concerts.astro';
import CtaCard from '../components/sections/CtaCard.astro';
import Hero from '../components/sections/Hero.astro';
import Card from '../components/ui/Card.astro';
import Layout from '../layouts/Layout.astro';
import { getConcerts, splitConcerts } from '../data/concerts';
import churchExterior from '../assets/venue/petruskirche-exterior.webp';

const result = await getConcerts(env);
const { programmeConcerts } = splitConcerts(result.concerts);
---

<Layout title="Konzerte in der Petruskirche Kiel" description="Konzertkirche Petruskirche Kiel: Programm, Besuchsplanung und Raum für Kulturveranstaltungen in besonderer Akustik.">
  <main class="min-h-screen bg-role-dominant text-role-on">
    <Hero />
    <Concerts
      concerts={programmeConcerts.slice(0, 3)}
      emptyMessage={result.error ? 'Das aktuelle Konzertprogramm konnte gerade nicht geladen werden. Bitte versuchen Sie es später erneut.' : undefined}
    />

    <section class="py-16 md:py-44" aria-label="Zitat über Musik">
      <div class="mx-auto flex w-full max-w-3xl flex-col items-center px-6 text-center md:px-8">
        <blockquote class="max-w-none text-center font-display text-2xl/tight font-normal italic tracking-tight text-white md:text-4xl/tight">
          Musik drückt das aus, was nicht gesagt werden kann und worüber zu schweigen unmöglich ist.
        </blockquote>
        <div class="mt-6 inline-flex items-center justify-center gap-4 text-center">
          <span class="h-px w-6 bg-secondary/25" aria-hidden="true"></span>
          <cite class="block text-center font-body text-xs/4 font-semibold uppercase not-italic tracking-widest text-secondary">Victor Hugo</cite>
          <span class="h-px w-6 bg-secondary/25" aria-hidden="true"></span>
        </div>
      </div>
    </section>

    <section class="relative overflow-hidden border-y border-white/5 bg-surface py-16 md:py-24 lg:py-32" aria-labelledby="architecture-heading">
      <div class="relative mx-auto grid w-full max-w-screen-2xl grid-cols-1 items-center gap-10 px-6 md:grid-cols-2 md:gap-12 md:px-8 lg:gap-16 lg:px-16">
        <div class="order-2 md:order-1">
          <h2 id="architecture-heading" class="block font-body text-xs/4 font-semibold uppercase tracking-widest text-secondary">Architektur &amp; Raumklang</h2>
          <div class="mt-6 grid max-w-2xl gap-6 font-body text-base/7 text-role-on/70 md:max-w-none md:text-lg/8">
            <p>
              Die Petruskirche in Kiel-Wik besticht nicht nur durch ihre neugotische Architektur, sondern vor allem durch eine Akustik, die Stimmen, Orgel und Ensembleklang besonders klar trägt.
            </p>
            <p>
              Der weite Kirchenraum bietet mit seinen hohen Gewölben den Resonanzkörper für orchestrale Werke, während die intime Atmosphäre des Altarraums kammermusikalischen Darbietungen einen besonderen Rahmen verleiht.
            </p>
          </div>
        </div>
        <div class="order-1 md:order-2">
          <Card as="figure" class="aspect-[4/5] bg-slate-mist/30 shadow-panel">
            <Image
              src={churchExterior}
              alt="Außenansicht der Petruskirche Kiel mit neugotischer Backsteinarchitektur"
              class="h-full w-full object-cover object-[50%_42%]"
              widths={[480, 640, 960]}
              loading="lazy"
              decoding="async"
            />
          </Card>
        </div>
      </div>
    </section>

    <section class="bg-midnight py-20 md:py-32" aria-labelledby="service-heading">
      <div class="mx-auto w-full max-w-screen-2xl px-6 md:px-8 lg:px-16">
        <h2 id="service-heading" class="block font-body text-xs/4 font-semibold uppercase tracking-widest text-secondary mb-8 max-w-3xl md:mb-10">Ihren Besuch &amp; Events planen</h2>
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          <CtaCard
            href="/besuch-planen"
            icon="i"
            title="Besuch planen"
            body="Alles Wichtige für Ihren Konzertbesuch: Anfahrt, Parkmöglichkeiten in der Kieler Wik sowie Informationen zur Barrierefreiheit."
            cta="Besucherinfos ansehen"
          />

          <CtaCard
            href="/raum-anfragen"
            icon="◇"
            title="Raum anfragen"
            body="Sie möchten die Petruskirche für eigene Kulturveranstaltungen, Konzerte oder Aufnahmen nutzen? Informieren Sie sich über Technik, Akustik und Konditionen."
            cta="Jetzt unverbindlich anfragen"
          />
        </div>
      </div>
    </section>
  </main>
</Layout>
