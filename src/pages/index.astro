---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Konzerte in der Petruskirche">
  <main class="min-h-screen bg-midnight text-on-surface">
    <section class="site-container grid min-h-screen place-items-center py-section-sm">
      <div class="surface-panel max-w-4xl rounded-4xl px-6 py-12 text-center sm:px-10 lg:px-16 lg:py-20">
        <p class="editorial-label uppercase">Kieler Konzertkirche</p>
        <h1 class="mx-auto mt-5 max-w-3xl font-display text-display text-champagne">
          Konzerte in der Petruskirche
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lead text-on-surface/85">
          Ein dunkles, ruhiges Gestaltungsfundament für klassische Musik, Raumklang und besondere
          Programme in architektonischer Atmosphäre.
        </p>
        <p class="mx-auto mt-8 max-w-xl text-sm leading-6 text-on-surface/65">
          Die vollständige Startseite folgt in AKG-17. AKG-10 stellt dafür Typografie,
          Farbklima, Abstände und barrierearme Basiszustände bereit.
        </p>
      </div>
    </section>
  </main>
</Layout>
