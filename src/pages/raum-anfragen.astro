---
import { Image } from 'astro:assets';

import PageHero from '../components/sections/PageHero.astro';
import Card from '../components/ui/Card.astro';
import Layout from '../layouts/Layout.astro';
import orgelMikrofon from '../assets/concerts/orgel-mikrofon.jpg';
import sinfonieFenster from '../assets/concerts/sinfonie-fenster.jpg';

const basics = [
  ['Kapazität', 'Bis zu 450 Sitzplätze im Kirchenschiff. Flexible Bestuhlung auf Anfrage möglich.'],
  ['Bühnenbereich', 'Der Chorraum dient als erhöhte Bühne (ca. 60 qm). Ausgezeichnete Akustik für unverstärkte Musik.'],
  ['Ausstattung', 'Konzertflügel, historische Orgel, Basis-Beleuchtungskonzept und Stromanschlüsse (16A/32A).'],
  ['Backstage', 'Zwei beheizbare Künstlergarderoben mit direktem Zugang zum Bühnenbereich und separate Sanitäranlagen.']
];

const inputClass =
  'w-full border-0 border-b border-white/30 bg-transparent px-0 py-4 font-body text-base/6 text-on-surface placeholder:text-role-on/40 focus:border-secondary focus:ring-0';
const labelClass =
  'mb-2 block font-body text-xs/4 font-semibold uppercase tracking-widest text-role-on/70';
---

<Layout
  title="Raum anfragen · Konzertkirche Petruskirche"
  description="Petruskirche Kiel als Raum für Konzerte, Chöre, Orchester, Aufnahmen und ausgewählte Kulturveranstaltungen anfragen."
>
  <main class="min-h-screen bg-midnight text-role-on">
    <PageHero
      eyebrow="Veranstaltungsräume"
      intro="Die Petruskirche Kiel bietet einen besonderen Rahmen für Konzerte, Chöre, Orchester und ausgewählte kulturelle Veranstaltungen."
      image={sinfonieFenster}
      imageAlt="Reflexion von Kirchenfenstern auf einem Konzertflügel"
      imagePosition="52% 45%"
    >
      Raum anfragen
    </PageHero>

    <section class="mx-auto w-full max-w-screen-2xl px-6 md:px-8 lg:px-16 grid grid-cols-1 gap-12 pb-20 pt-16 lg:grid-cols-12 lg:gap-8 md:pb-28 md:pt-24" aria-label="Rauminformationen und Buchungsanfrage">
      <div class="space-y-6 lg:col-span-5">
        <Card as="article" class="border-white/5 bg-slate-mist/30">
          <Image
            src={orgelMikrofon}
            alt="Detailaufnahme von Konzertflügel, Mikrofon und Kirchenfenstern"
            class="h-56 !w-full object-cover"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 40vw, calc(100vw - 48px)"
            loading="lazy"
            decoding="async"
            format="webp"
          />
          <div class="p-8">
            <h2 class="block font-body text-xs/4 font-semibold uppercase tracking-widest text-role-on/60 mb-8">Basisinformationen</h2>
            <ul class="space-y-6" role="list">
              {
                basics.map(([title, text]) => (
                  <li class="flex gap-4">
                    <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-secondary" aria-hidden="true" />
                    <div>
                      <h3 class="font-body text-lg/7 font-semibold text-on-surface">{title}</h3>
                      <p class="mt-2 font-body text-base/7 text-role-on/70">{text}</p>
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>
        </Card>
      </div>

      <div class="lg:col-span-7">
        <Card class="border-white/5 bg-surface/70 p-8 backdrop-blur-sm md:p-10">
          <h2 class="block font-body text-xs/4 font-semibold uppercase tracking-widest text-role-on/60 mb-6">Unverbindlich anfragen</h2>
          <p class="max-w-2xl font-body text-base/7 text-role-on/70">
            Beschreiben Sie kurz Ihr Vorhaben – wir melden uns in der Regel innerhalb weniger Werktage. Mit <span class="text-secondary">*</span> markierte Felder sind Pflichtfelder.
          </p>

          <form action="mailto:[EMAIL]" method="post" enctype="text/plain" class="mt-10 space-y-10">
            <fieldset class="space-y-8 border-0 p-0">
              <legend class="mb-2 font-body text-xs/4 font-semibold uppercase tracking-widest text-secondary">Ihre Veranstaltung</legend>
              <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
                <div>
                  <label class={labelClass} for="event-type">Art der Veranstaltung <span class="text-secondary" aria-hidden="true">*</span></label>
                  <input class={inputClass} id="event-type" name="Art der Veranstaltung" required type="text" />
                </div>
                <div>
                  <label class={labelClass} for="date">Wunschdatum / Zeitraum <span class="text-secondary" aria-hidden="true">*</span></label>
                  <input class={inputClass} id="date" name="Wunschdatum / Zeitraum" required type="text" />
                </div>
                <div>
                  <label class={labelClass} for="attendees">Erwartete Besucherzahl</label>
                  <input class={inputClass} id="attendees" name="Erwartete Besucherzahl" min="1" max="450" inputmode="numeric" type="number" />
                </div>
              </div>
            </fieldset>

            <fieldset class="space-y-8 border-0 border-t border-white/10 pt-10 p-0">
              <legend class="mb-2 font-body text-xs/4 font-semibold uppercase tracking-widest text-secondary">Kontakt</legend>
              <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
                <div>
                  <label class={labelClass} for="name">Name / Organisation <span class="text-secondary" aria-hidden="true">*</span></label>
                  <input class={inputClass} id="name" name="Name / Organisation" autocomplete="organization" required type="text" />
                </div>
                <div>
                  <label class={labelClass} for="email">E-Mail <span class="text-secondary" aria-hidden="true">*</span></label>
                  <input class={inputClass} id="email" name="E-Mail" autocomplete="email" required type="email" />
                </div>
                <div>
                  <label class={labelClass} for="phone">Telefon</label>
                  <input class={inputClass} id="phone" name="Telefon" autocomplete="tel" type="tel" />
                </div>
              </div>
            </fieldset>

            <fieldset class="space-y-8 border-0 border-t border-white/10 pt-10 p-0">
              <legend class="mb-2 font-body text-xs/4 font-semibold uppercase tracking-widest text-secondary">Anmerkungen</legend>
              <div>
                <label class={labelClass} for="technical-requirements">Technische Anforderungen &amp; Bemerkungen</label>
                <textarea class="min-h-36 w-full resize-y border-0 border-b border-white/30 bg-transparent px-0 py-4 font-body text-base/6 text-on-surface placeholder:text-role-on/40 focus:border-secondary focus:ring-0" id="technical-requirements" name="Technische Anforderungen und Bemerkungen" rows="5"></textarea>
              </div>
            </fieldset>

            <div>
              <button class="inline-flex min-h-14 w-full items-center justify-center rounded-sm bg-secondary px-8 py-4 font-body text-xs/4 font-semibold uppercase tracking-widest text-midnight shadow-glow transition hover:bg-champagne active:scale-95 md:w-auto" type="submit">
                Anfrage per E-Mail senden
              </button>
              <p class="mt-4 font-body text-sm/6 text-role-on/60">
                Beim Absenden öffnet sich Ihr E-Mail-Programm mit der vorbereiteten Anfrage. Alternativ erreichen Sie uns direkt unter
                <a class="!text-secondary no-underline hover:!text-champagne" href="mailto:[EMAIL]">[EMAIL]</a>.
              </p>
            </div>
          </form>
        </Card>
      </div>
    </section>
  </main>
</Layout>
