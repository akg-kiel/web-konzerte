---
export const prerender = false;

import { env } from 'cloudflare:workers';

import ConcertFilters from '../components/sections/ConcertFilters';
import Concerts from '../components/sections/Concerts.astro';
import PageHero from '../components/sections/PageHero.astro';
import ProgrammeNavigation from '../components/sections/ProgrammeNavigation.astro';
import Layout from '../layouts/Layout.astro';
import { getProgrammeSeo } from '../lib/seo';
import {
  cacheProgramme,
  filterConcerts,
  getConcertFilters,
  getConcerts,
  hasInvalidConcertDateRange,
  paginateConcerts,
  splitConcerts
} from '../data/concerts';

cacheProgramme(Astro.response);
const result = await getConcerts(env);
const { programmeConcerts } = splitConcerts(result.concerts);
const filters = getConcertFilters(Astro.url.searchParams);
const rangeError = hasInvalidConcertDateRange(filters)
  ? 'Das Startdatum muss vor dem Enddatum liegen.'
  : undefined;
const filteredConcerts = rangeError ? [] : filterConcerts(programmeConcerts, filters);
const { pageConcerts, page, pageCount } = paginateConcerts(filteredConcerts, Astro.url.searchParams);
const seo = getProgrammeSeo(Astro.site!, Astro.url, filters, page);
const emptyMessage = rangeError
  ? 'Korrigieren Sie den ausgewählten Zeitraum.'
  : Object.values(filters).some(Boolean)
    ? 'Für diese Filter wurden keine Konzerte gefunden. Ändern Sie die Suche oder setzen Sie die Filter zurück.'
    : undefined;
if (result.error) Astro.response.status = 503;

---

<Layout
  {...seo}
  title="Konzerte in Kiel | Programm der Petruskirche"
  description="Aktuelle Konzerte in Kiel: Programm der Petruskirche mit Klassik, Chor, Musical, Orgel und Crossover sowie Ticketlinks, sobald der Vorverkauf startet."
>
  <main class="min-h-screen bg-midnight text-role-on">
    <PageHero
      eyebrow="Konzertprogramm"
      intro="Klassik, Chor, Musical und Crossover – die nächsten Konzerte in der Petruskirche."
    >
      Konzerte in Kiel
    </PageHero>

    <section class="border-y border-white/5 bg-surface/50 py-12" aria-label="Konzertsuche">
        <div class="mx-auto w-full max-w-screen-2xl px-6 md:px-8 lg:px-16">
          <ProgrammeNavigation />
          <ConcertFilters
            action="/programm/"
            anchor="programm"
            filters={filters}
            matchCount={filteredConcerts.length}
            rangeError={rangeError}
            totalCount={programmeConcerts.length}
            client:load
          />
        </div>
    </section>

    {result.error && (
      <p class="mx-auto my-12 w-[calc(100%-3rem)] max-w-screen-2xl rounded-sm border border-secondary/40 bg-secondary/10 px-6 py-4 font-body text-base/7 text-role-on" role="alert">
        Das Konzertprogramm kann gerade nicht geladen werden. Bitte versuchen Sie es später erneut.
      </p>
    )}

    <Concerts
      id="programm"
      concerts={pageConcerts}
      variant="programme"
      page={page}
      pageCount={pageCount}
      eyebrow="Alle Konzerte"
      intro=""
      emptyMessage={emptyMessage}
      showHeaderLink={false}
    />

    <section class="border-t border-white/5 bg-surface py-16 md:py-20" aria-labelledby="venue-heading">
      <div class="mx-auto grid w-full max-w-screen-2xl gap-8 px-6 md:grid-cols-2 md:px-8 lg:px-16">
        <div>
          <h2 id="venue-heading" class="font-body text-xs/4 font-semibold uppercase tracking-widest text-secondary">Veranstaltungsort</h2>
          <p class="mt-4 font-display text-2xl/tight text-white">Konzertkirche Petruskirche</p>
          <p class="mt-2 font-body text-base/7 text-role-on/70">Weimarer Straße 1 · 24106 Kiel</p>
        </div>
        <div>
          <h2 class="font-body text-xs/4 font-semibold uppercase tracking-widest text-secondary">Barrierefreiheit</h2>
          <p class="mt-4 max-w-xl font-body text-base/7 text-role-on/70">Stufenloser Zugang, Plätze für Rollstühle und ein rollstuhlgerechtes WC sind vorhanden.</p>
          <a class="mt-4 inline-flex font-body text-xs/4 font-semibold uppercase tracking-widest !text-secondary no-underline hover:!text-champagne" href="/besuch-planen/#access-heading">Besuch planen →</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
