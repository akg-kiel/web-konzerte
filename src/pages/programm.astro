---
export const prerender = false;

import { env } from 'cloudflare:workers';

import ConcertFilters from '../components/sections/ConcertFilters.astro';
import Concerts from '../components/sections/Concerts.astro';
import PageHero from '../components/sections/PageHero.astro';
import Layout from '../layouts/Layout.astro';
import {
  cacheProgramme,
  filterConcerts,
  getConcertFilters,
  getConcertSeason,
  getConcerts,
  paginateConcerts,
  splitConcerts
} from '../data/concerts';

cacheProgramme(Astro.response);
const result = await getConcerts(env);
const { programmeConcerts } = splitConcerts(result.concerts);
const filters = getConcertFilters(Astro.url.searchParams);
const filteredConcerts = filterConcerts(programmeConcerts, filters);
const { pageConcerts, page, pageCount } = paginateConcerts(filteredConcerts, Astro.url.searchParams);
const emptyMessage = Object.values(filters).some(Boolean)
  ? 'Für diese Filter wurden keine Konzerte gefunden. Ändern Sie die Suche oder setzen Sie die Filter zurück.'
  : undefined;
if (result.error) Astro.response.status = 503;

const seasonConcerts = filterConcerts(programmeConcerts, { ...filters, season: '' });
const seasons = Object.entries(Object.groupBy(seasonConcerts, getConcertSeason));
const seasonHref = (season: string) => {
  const params = new URLSearchParams();
  if (filters.search) params.set('q', filters.search);
  if (filters.from) params.set('from', filters.from);
  if (filters.to) params.set('to', filters.to);
  params.set('season', season);
  return `/programm/?${params}#programm`;
};
---

<Layout
  title="Programm & Tickets · Konzertkirche Petruskirche"
  description="Programm und Tickets der Konzertkirche Petruskirche Kiel: Klassik, Chor, Musical, Orgel und Crossover im Kirchenraum."
>
  <main class="min-h-screen bg-midnight text-role-on">
    <PageHero
      eyebrow="Konzerte in Kiel-Wik"
      intro="Alle kommenden Konzerte in der Petruskirche auf einen Blick – chronologisch sortiert, mit Ticketlinks, sobald der Vorverkauf startet."
    >
      Programm &amp; Tickets
    </PageHero>

    <section class="border-y border-white/5 bg-surface/50 py-12" aria-labelledby="seasons-heading">
        <div class="mx-auto w-full max-w-screen-2xl px-6 md:px-8 lg:px-16">
          <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
            <div>
              <h2 id="seasons-heading" class="font-body text-xs/4 font-semibold uppercase tracking-widest text-secondary">Saisonübersicht</h2>
              <div class="mt-6 flex flex-wrap gap-4">
                {seasons.map(([season, entries]) => (
                  <a
                    class:list={[
                      'rounded-sm border px-6 py-4 no-underline transition hover:border-secondary/40 hover:bg-secondary/5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary',
                      filters.season === season ? 'border-secondary bg-secondary/10' : 'border-white/10 bg-white/5'
                    ]}
                    href={seasonHref(season)}
                    aria-current={filters.season === season ? 'true' : undefined}
                  >
                    <span class="block font-display text-2xl/tight text-white">Saison {season}</span>
                    <span class="mt-2 block font-body text-sm/6 text-role-on/60">{entries?.length ?? 0} {entries?.length === 1 ? 'Konzert' : 'Konzerte'}</span>
                  </a>
                ))}
              </div>
            </div>
            <a class="inline-flex min-h-12 items-center gap-2 self-start font-body text-xs/4 font-semibold uppercase tracking-widest !text-secondary no-underline transition hover:!text-champagne md:self-auto" href="/programm/archiv/">
              Zum Konzertarchiv <span aria-hidden="true">→</span>
            </a>
          </div>
          <ConcertFilters
            action="/programm/"
            anchor="programm"
            filters={filters}
            seasons={seasons.map(([season]) => season)}
            matchCount={filteredConcerts.length}
            totalCount={programmeConcerts.length}
          />
        </div>
    </section>

    {result.error && (
      <p class="mx-auto my-12 w-[calc(100%-3rem)] max-w-screen-2xl rounded-sm border border-secondary/40 bg-secondary/10 px-6 py-4 font-body text-base/7 text-role-on" role="alert">
        Das Konzertprogramm kann gerade nicht geladen werden. Bitte versuchen Sie es später erneut.
      </p>
    )}

    <Concerts
      id="programm"
      concerts={pageConcerts}
      variant="programme"
      page={page}
      pageCount={pageCount}
      eyebrow="Alle Termine"
      intro=""
      emptyMessage={emptyMessage}
      showHeaderLink={false}
    />

    <section class="border-t border-white/5 bg-surface py-16 md:py-20" aria-labelledby="venue-heading">
      <div class="mx-auto grid w-full max-w-screen-2xl gap-8 px-6 md:grid-cols-2 md:px-8 lg:px-16">
        <div>
          <h2 id="venue-heading" class="font-body text-xs/4 font-semibold uppercase tracking-widest text-secondary">Veranstaltungsort</h2>
          <p class="mt-4 font-display text-2xl/tight text-white">Konzertkirche Petruskirche</p>
          <p class="mt-2 font-body text-base/7 text-role-on/70">Weimarer Straße 1 · 24106 Kiel</p>
        </div>
        <div>
          <h2 class="font-body text-xs/4 font-semibold uppercase tracking-widest text-secondary">Barrierefreiheit</h2>
          <p class="mt-4 max-w-xl font-body text-base/7 text-role-on/70">Stufenloser Zugang, Plätze für Rollstühle und ein rollstuhlgerechtes WC sind vorhanden.</p>
          <a class="mt-4 inline-flex font-body text-xs/4 font-semibold uppercase tracking-widest !text-secondary no-underline hover:!text-champagne" href="/besuch-planen/#access-heading">Besucherinformationen →</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
