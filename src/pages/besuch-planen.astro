---
import { Image } from 'astro:assets';

import PageHero from '../components/sections/PageHero.astro';
import Layout from '../layouts/Layout.astro';
import heroStage from '../assets/hero/l1130722-hero.jpg';
import orgelMikrofon from '../assets/concerts/orgel-mikrofon.jpg';
---

<Layout
  title="Ihren Besuch planen · Konzertkirche Petruskirche"
  description="Informationen zu Anfahrt, Parken, Einlass, Abendkasse, Barrierefreiheit und Café Dreimaster für die Petruskirche Kiel."
>
  <main class="min-h-screen bg-midnight text-role-on">
    <PageHero
      eyebrow="Gastfreundschaft"
      intro="Alle wichtigen Informationen für einen reibungslosen und inspirierenden Aufenthalt in der Konzertkirche Petruskirche Kiel."
      image={heroStage}
      imageAlt="Innenraum der Petruskirche während einer musikalischen Veranstaltung"
      imagePosition="64% 50%"
    >
      Ihren Besuch planen
    </PageHero>

    <div class="site-container space-y-20 py-16 md:space-y-28 md:py-24">
      <section aria-labelledby="arrival-heading">
        <h2 id="arrival-heading" class="section-label mb-8">Anfahrt &amp; Parken</h2>

        <div class="mt-0 grid grid-cols-1 gap-10 lg:grid-cols-[1fr_minmax(0,1.1fr)] lg:gap-16">
          <div class="space-y-8">
            <div>
              <h3 class="font-body text-lg font-semibold text-on-surface">ÖPNV</h3>
              <p class="mt-2 font-body text-base leading-7 text-role-on/72">
                Die nächste Bushaltestelle „Petruskirche“ liegt nur wenige Gehminuten entfernt. Nutzen Sie je nach Verbindung die Linien 11, 60S oder 501.
              </p>
            </div>
            <div>
              <h3 class="font-body text-lg font-semibold text-on-surface">Auto &amp; Parken</h3>
              <p class="mt-2 font-body text-base leading-7 text-role-on/72">
                Rund um die Kirche gibt es begrenzte kostenfreie Parkmöglichkeiten an der Straße. Planen Sie bei größeren Veranstaltungen zusätzliche Zeit ein.
              </p>
            </div>
            <p class="font-body text-base leading-7 text-role-on/72">
              <span class="block font-semibold text-on-surface">Petruskirche Kiel-Wik</span>
              Weimarer Straße 1 · 24106 Kiel ·
              <a class="!text-secondary no-underline hover:!text-champagne" href="https://www.openstreetmap.org/search?query=Weimarer%20Stra%C3%9Fe%201%2024106%20Kiel" target="_blank" rel="noopener noreferrer">Karte öffnen ↗</a>
            </p>
          </div>

          <iframe
            title="OpenStreetMap – Petruskirche Kiel-Wik"
            class="aspect-[4/3] w-full rounded-[0.5rem] border border-white/10 grayscale-[0.2] lg:aspect-[16/10]"
            loading="lazy"
            src="https://www.openstreetmap.org/export/embed.html?bbox=10.1310%2C54.3220%2C10.1370%2C54.3260&layer=mapnik&marker=54.3240%2C10.1340"
          />
        </div>
      </section>

      <section aria-labelledby="admission-heading">
        <h2 id="admission-heading" class="section-label mb-8">Einlass &amp; Abendkasse</h2>
        <p class="max-w-2xl font-body text-lg leading-8 text-role-on/72">
          Um Ihnen ein entspanntes Konzerterlebnis zu ermöglichen, öffnen wir unsere Türen frühzeitig. Abweichende Zeiten entnehmen Sie bitte Ihrem jeweiligen Veranstaltungshinweis.
        </p>
        <dl class="mt-8 grid grid-cols-1 gap-x-12 gap-y-6 sm:grid-cols-2 max-w-3xl">
          <div>
            <dt class="font-body text-base font-semibold text-on-surface">Einlass</dt>
            <dd class="mt-1 font-body text-base leading-7 text-role-on/70">In der Regel 45 Minuten vor Veranstaltungsbeginn.</dd>
          </div>
          <div>
            <dt class="font-body text-base font-semibold text-on-surface">Abendkasse</dt>
            <dd class="mt-1 font-body text-base leading-7 text-role-on/70">Öffnet zeitgleich mit dem Einlass. Wir empfehlen bargeldlose Zahlung.</dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="access-heading">
        <h2 id="access-heading" class="section-label mb-8">Barrierefreiheit</h2>
        <div class="grid max-w-3xl grid-cols-1 gap-8 font-body text-base leading-7 text-role-on/72 md:grid-cols-2">
          <div>
            <h3 class="font-body text-lg font-semibold text-on-surface">Stufenloser Zugang</h3>
            <p class="mt-2">Der Haupteingang ist über eine flache Rampe stufenlos erreichbar. Im Kirchenschiff sind keine Stufen vorhanden.</p>
          </div>
          <div>
            <h3 class="font-body text-lg font-semibold text-on-surface">Sanitäre Anlagen</h3>
            <p class="mt-2">Ein rollstuhlgerechtes WC befindet sich im anliegenden Gemeindehaus und ist während Veranstaltungen ausgeschildert.</p>
          </div>
        </div>
        <p class="mt-8 max-w-3xl rounded-sm border-l-2 border-secondary bg-secondary/5 py-3 pl-5 text-on-surface">
          Für die Reservierung spezifischer Rollstuhlplätze bitten wir um vorherige Kontaktaufnahme.
        </p>
      </section>

      <section aria-labelledby="cafe-heading">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center lg:gap-12">
          <Image
            src={orgelMikrofon}
            alt="Atmosphärisches Detail mit Mikrofon und Kirchenfenstern"
            class="aspect-[4/3] w-full rounded-[0.5rem] object-cover"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 40vw, calc(100vw - 40px)"
            loading="lazy"
            decoding="async"
            format="webp"
          />
          <div>
            <h2 id="cafe-heading" class="section-label mb-5">Café Dreimaster</h2>
            <p class="font-body text-base leading-7 text-role-on/72">
              Stimmen Sie sich kulinarisch auf den Abend ein oder lassen Sie das Konzert gemütlich ausklingen. Direkt neben der Kirche gelegen.
            </p>
            <a class="mt-6 inline-flex min-h-11 items-center gap-2 font-body text-[12px] font-semibold uppercase leading-4 tracking-[0.1em] !text-secondary no-underline transition hover:!text-champagne" href="https://akg-kiel.de" target="_blank" rel="noopener noreferrer">Mehr erfahren ↗</a>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>
