---
export const prerender = false;

import { env } from 'cloudflare:workers';

import ConcertFilters from '../../components/sections/ConcertFilters.astro';
import Concerts from '../../components/sections/Concerts.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Layout from '../../layouts/Layout.astro';
import {
  cacheProgramme,
  filterConcerts,
  getConcertFilters,
  getConcertSeason,
  getConcerts,
  splitConcerts
} from '../../data/concerts';

cacheProgramme(Astro.response);
const result = await getConcerts(env);
const { archiveConcerts } = splitConcerts(result.concerts);
const filters = getConcertFilters(Astro.url.searchParams);
const filteredConcerts = filterConcerts(archiveConcerts, filters);
const emptyMessage = Object.values(filters).some(Boolean)
  ? 'Für diese Filter wurden keine Konzerte gefunden. Ändern Sie die Suche oder setzen Sie die Filter zurück.'
  : undefined;
const seasons = [...new Set(archiveConcerts.map(getConcertSeason))];
if (result.error) Astro.response.status = 503;
---

<Layout
  title="Konzertarchiv · Konzertkirche Petruskirche"
  description="Vergangene Konzerte und Programme der Konzertkirche Petruskirche Kiel."
>
  <main class="min-h-screen bg-midnight text-role-on">
    <PageHero
      eyebrow="Programm"
      intro="Vergangene Konzerte, Mitwirkende und Programme aus der Konzertkirche Petruskirche."
    >
      Konzertarchiv
      <a
        slot="cta"
        class="inline-flex min-h-12 items-center justify-center rounded-sm border border-white/20 px-6 py-3 font-body text-xs/4 font-semibold uppercase tracking-widest !text-role-on no-underline transition hover:border-secondary hover:!text-secondary"
        href="/programm"
      >
        Aktuelles Programm
      </a>
    </PageHero>

    <section class="border-y border-white/5 bg-role-support px-6 py-12 md:px-8 lg:px-16" aria-labelledby="archive-filter-heading">
      <div class="mx-auto w-full max-w-screen-2xl">
        <h2 id="archive-filter-heading" class="font-display text-2xl/tight text-white">Archiv durchsuchen</h2>
        <ConcertFilters
          action="/programm/archiv"
          anchor="archiv"
          filters={filters}
          seasons={seasons}
          matchCount={filteredConcerts.length}
          totalCount={archiveConcerts.length}
        />
      </div>
    </section>

    {result.error && (
      <p class="mx-auto my-12 w-[calc(100%-3rem)] max-w-screen-2xl rounded-sm border border-secondary/40 bg-secondary/10 px-6 py-4 font-body text-base/7 text-role-on" role="alert">
        Das Konzertarchiv kann gerade nicht geladen werden. Bitte versuchen Sie es später erneut.
      </p>
    )}

    <Concerts
      id="archiv"
      concerts={filteredConcerts}
      variant="archive"
      eyebrow="Vergangene Konzerte"
      emptyMessage={emptyMessage}
      showHeaderLink={false}
    />
  </main>
</Layout>
