---
import { Image } from 'astro:assets';

import ConcertCard from '../../components/sections/ConcertCard.astro';
import Layout from '../../layouts/Layout.astro';
import { passionConcert, relatedConcerts } from '../../data/concerts';
import heroStage from '../../assets/hero/l1130722-hero.jpg';

if (!passionConcert) {
  throw new Error('Missing Die Passion 2026 concert data');
}

const infoItems = [
  ['Datum', 'Sonntag, 22.03.2026'],
  ['Uhrzeit', '18:00 Uhr'],
  ['Einlass', 'Ab 17:15 Uhr'],
  ['Dauer', 'ca. 140 Minuten (inkl. Pause)'],
  ['Preis', '25€ - 45€ (Ermäßigungen verfügbar)'],
  ['Veranstaltungsort', 'Konzertkirche Petruskirche Kiel, Weimarer Str. 1, 24106 Kiel'],
  ['Barrierefreiheit', 'Rollstuhlgerechter Zugang und Plätze vorhanden.']
];
---

<Layout title="Die Passion 2026 - Das Musical · Konzertkirche Petruskirche" description="Detailseite zu Die Passion 2026 - Das Musical in der Konzertkirche Petruskirche Kiel am 22. März 2026.">
  <main class="min-h-screen bg-midnight text-role-on">
    <section class="relative flex min-h-[72svh] items-end overflow-hidden pt-20 md:min-h-[85svh]" aria-labelledby="detail-heading">
      <Image
        src={heroStage}
        alt="Chorprobe im Kirchenraum der Petruskirche"
        class="absolute inset-0 !h-full !w-full object-cover object-[64%_52%]"
        widths={[640, 960, 1280, 1600, 1920]}
        sizes="100vw"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        format="webp"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-midnight/30 via-midnight/20 to-midnight" aria-hidden="true"></div>
      <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-midnight via-midnight/80 to-transparent" aria-hidden="true"></div>
      <div class="site-container relative z-10 pb-16 md:pb-24">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="max-w-4xl">
            <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/20 bg-slate-mist/40 px-3 py-1 font-body text-[12px] font-semibold uppercase leading-4 tracking-[0.1em] text-primary backdrop-blur-md">
              <span class="h-2 w-2 rounded-full bg-secondary" aria-hidden="true"></span>
              Musical Premiere
            </p>
            <h1 id="detail-heading" class="font-display text-[clamp(3rem,8vw,6rem)] font-normal leading-[1.02] tracking-[-0.045em] text-white">Die Passion 2026 -<br />Das Musical</h1>
            <p class="mt-5 font-display text-[clamp(1.5rem,4vw,2.3rem)] font-normal leading-tight text-secondary/90">
              Sonntag 22.03.2026, 18:00 Uhr
            </p>
          </div>
          {passionConcert.ticketUrl && (
            <a class="inline-flex min-h-14 shrink-0 items-center justify-center rounded-full bg-secondary px-8 py-4 font-body text-[12px] font-semibold uppercase leading-4 tracking-[0.1em] !text-midnight no-underline shadow-[0_0_30px_rgb(var(--color-secondary-rgb)/0.25)] transition hover:bg-champagne active:scale-95" href={passionConcert.ticketUrl}>
              Tickets kaufen
            </a>
          )}
        </div>
      </div>
    </section>

    <section class="site-container py-16 md:py-24" aria-labelledby="passion-about-heading">
      <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-8">
        <article class="space-y-8 lg:col-span-8">
          <h2 id="passion-about-heading" class="border-b border-white/10 pb-4 font-display text-[clamp(2.4rem,6vw,3.4rem)] font-normal leading-tight tracking-[-0.03em] text-secondary">Was ist die Passion 2026?</h2>
          <div class="space-y-6 font-body text-lg leading-8 text-role-on/74">
            <p class="font-semibold text-primary">
              Ein monumentales musikalisches Ereignis, das die jahrhundertealte Tradition der Passionsspiele mit der modernen Kraft des Musicals vereint.
            </p>
            <p>
              Über 100 Mitwirkende – ein großer symphonischer Chor, renommierte Solisten aus der Musicalszene und ein eigens für dieses Projekt zusammengestelltes Orchester – erwecken die biblische Erzählung zu neuem Leben.
            </p>
            <p>
              Die Komposition verbindet klassische orchestrale Elemente mit treibenden modernen Rhythmen und berührenden Balladen. Die architektonische Weite des Kirchenraums wird durch eine Lichtinszenierung bespielt, die das Publikum auch visuell in das Geschehen hineinzieht.
            </p>
            <blockquote class="border-l-2 border-secondary py-2 pl-6 font-display text-[clamp(1.6rem,4vw,2.3rem)] italic leading-tight text-white">
              „Eine musikalische Offenbarung, die den sakralen Raum der Petruskirche auf völlig neue Weise erlebbar macht.“
            </blockquote>
            <p>
              Die musikalische Leitung liegt bei KMD Johannes K.; das Werk wurde speziell für die räumlichen Gegebenheiten der Konzertkirche adaptiert.
            </p>
          </div>

          <div class="grid grid-cols-1 gap-4 border-t border-white/10 pt-8 sm:grid-cols-2" aria-label="Ensemble und Leitung">
            <section class="rounded-[0.5rem] border border-white/5 bg-slate-mist/30 p-6">
              <h3 class="font-body text-[12px] font-semibold uppercase leading-4 tracking-[0.1em] text-primary">Ensemble</h3>
              <p class="mt-3 font-body text-base leading-7 text-role-on/72">Großer Sinfonischer Chor der Petruskirche &amp; Projektorchester Kiel</p>
            </section>
            <section class="rounded-[0.5rem] border border-white/5 bg-slate-mist/30 p-6">
              <h3 class="font-body text-[12px] font-semibold uppercase leading-4 tracking-[0.1em] text-primary">Leitung</h3>
              <p class="mt-3 font-body text-base leading-7 text-role-on/72">KMD Johannes K. (Musikalische Gesamtleitung)</p>
            </section>
          </div>
        </article>

        <aside class="lg:sticky lg:top-32 lg:col-span-4" aria-labelledby="short-info-heading">
          <div class="overflow-hidden rounded-[0.75rem] border border-white/10 bg-slate-mist/40 shadow-panel backdrop-blur-xl">
            <div class="h-1 bg-gradient-to-r from-transparent via-secondary/50 to-transparent" aria-hidden="true"></div>
            <div class="p-8">
              <h2 id="short-info-heading" class="font-display text-[clamp(1.9rem,4vw,2.5rem)] font-normal text-white">Kurzinfo</h2>
              <dl class="mt-6 space-y-5">
                {infoItems.map(([term, description]) => (
                  <div class="border-b border-white/5 pb-4 last:border-0 last:pb-0">
                    <dt class="mb-1 font-body text-[12px] font-semibold uppercase leading-4 tracking-[0.1em] text-role-on/56">{term}</dt>
                    <dd class="font-body text-base leading-7 text-primary">{description}</dd>
                  </div>
                ))}
              </dl>
            </div>
            {passionConcert.ticketUrl && (
              <div class="border-t border-white/10 bg-slate-mist/80 p-6" id="tickets">
                <a class="inline-flex min-h-14 w-full items-center justify-center rounded-[0.5rem] bg-secondary px-6 py-4 font-body text-[12px] font-semibold uppercase leading-4 tracking-[0.1em] !text-midnight no-underline transition hover:bg-champagne active:scale-95" href={passionConcert.ticketUrl}>
                  Tickets im Vorverkauf →
                </a>
              </div>
            )}
          </div>
          <p class="mt-6 text-center">
            <a class="font-body text-[12px] font-semibold uppercase leading-4 tracking-[0.1em] !text-role-on/70 no-underline hover:!text-secondary" href="/besuch-planen">Ihren Besuch planen</a>
          </p>
        </aside>
      </div>
    </section>

    <section class="border-t border-white/5 bg-gradient-to-b from-transparent to-surface/50 py-20 md:py-24" aria-labelledby="related-heading">
      <div class="site-container">
        <div class="mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end">
          <h2 id="related-heading" class="font-display text-[clamp(2.3rem,6vw,3.4rem)] font-normal text-primary">Andere Konzerte</h2>
          <a class="font-body text-[12px] font-semibold uppercase leading-4 tracking-[0.1em] !text-secondary no-underline hover:!text-champagne" href="/programm">Gesamtes Programm →</a>
        </div>
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          {relatedConcerts.map((concert) => <ConcertCard concert={concert} imageSizes="(min-width: 768px) 30vw, calc(100vw - 40px)" />)}
        </div>
      </div>
    </section>
  </main>
</Layout>
