---
import ConcertCard from '../../components/sections/ConcertCard.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Card from '../../components/ui/Card.astro';
import Layout from '../../layouts/Layout.astro';
import { passionConcert, relatedConcerts } from '../../data/concerts';
import heroStage from '../../assets/hero/l1130722-hero.jpg';

if (!passionConcert) {
  throw new Error('Missing Die Passion 2026 concert data');
}

const infoItems = [
  ['Datum', 'Sonntag, 21.03.2027'],
  ['Uhrzeit', '18:00 Uhr'],
  ['Einlass', 'Ab 17:15 Uhr'],
  ['Dauer', 'ca. 140 Minuten (inkl. Pause)'],
  ['Preis', '25€ - 45€ (Ermäßigungen verfügbar)'],
  ['Veranstaltungsort', 'Konzertkirche Petruskirche Kiel, Weimarer Str. 1, 24106 Kiel'],
  ['Barrierefreiheit', 'Rollstuhlgerechter Zugang und Plätze vorhanden.']
];
---

<Layout
  title="Die Passion 2026 - Das Musical · Konzertkirche Petruskirche"
  description="Detailseite zu Die Passion 2026 - Das Musical in der Konzertkirche Petruskirche Kiel am 21. März 2027."
>
  <main class="min-h-screen bg-midnight text-role-on">
    <PageHero
      image={heroStage}
      imageAlt="Chorprobe im Kirchenraum der Petruskirche"
      imagePosition="64% 52%"
      subtitle="Sonntag 21.03.2027, 18:00 Uhr"
    >
      <p
        slot="badge"
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/20 bg-slate-mist/40 px-4 py-2 font-body text-xs/4 font-semibold uppercase tracking-widest text-primary backdrop-blur-md"
      >
        <span class="h-2 w-2 rounded-full bg-secondary" aria-hidden="true"></span>
        Musical Premiere
      </p>
      Die Passion 2026 -<br />Das Musical
      {passionConcert.ticketUrl && (
        <a
          slot="cta"
          class="inline-flex min-h-14 items-center justify-center rounded-sm bg-secondary px-8 py-4 font-body text-xs/4 font-semibold uppercase tracking-widest !text-midnight no-underline shadow-glow transition hover:bg-champagne active:scale-95"
          href={passionConcert.ticketUrl}
        >
          Tickets kaufen
        </a>
      )}
    </PageHero>

    <section class="relative z-20 -mt-8 mx-auto w-full max-w-screen-2xl px-6 md:hidden md:px-8 lg:px-16" aria-label="Kurzinfo">
      <div class="grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-white/10 bg-white/5 backdrop-blur-xl">
        {[
          ['Datum', passionConcert.date.display.split(' • ')[0]],
          ['Beginn', passionConcert.date.time + ' Uhr'],
          ['Einlass', 'Ab 17:15 Uhr'],
          ['Preis', passionConcert.price]
        ].map(([term, value]) => (
          <div class="bg-surface/90 p-4">
            <p class="font-body text-xs/3 font-semibold uppercase tracking-widest text-role-on/50">{term}</p>
            <p class="mt-2 font-body text-sm/5 font-medium text-white">{value}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mx-auto w-full max-w-screen-2xl px-6 md:px-8 lg:px-16 py-16 md:py-24" aria-labelledby="passion-about-heading">
      <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-8">
        <article class="space-y-8 lg:col-span-8">
          <h2 id="passion-about-heading" class="block font-body text-xs/4 font-semibold uppercase tracking-widest text-role-on/60">Das Werk</h2>
          <div class="space-y-6 font-body text-lg/8 text-role-on/75">
            <p class="font-semibold text-primary">
              Ein monumentales musikalisches Ereignis, das die jahrhundertealte Tradition der Passionsspiele mit der modernen Kraft des Musicals vereint.
            </p>
            <p>
              Über 100 Mitwirkende – ein großer symphonischer Chor, renommierte Solisten aus der Musicalszene und ein eigens für dieses Projekt zusammengestelltes Orchester – erwecken die biblische Erzählung zu neuem Leben.
            </p>
            <p>
              Die Komposition verbindet klassische orchestrale Elemente mit treibenden modernen Rhythmen und berührenden Balladen. Die architektonische Weite des Kirchenraums wird durch eine Lichtinszenierung bespielt, die das Publikum auch visuell in das Geschehen hineinzieht.
            </p>
            <blockquote class="border-l-2 border-secondary py-2 pl-6 font-display text-2xl/tight italic text-white md:text-4xl/tight">
              „Eine musikalische Offenbarung, die den sakralen Raum der Petruskirche auf völlig neue Weise erlebbar macht.“
            </blockquote>
            <p>
              Die musikalische Leitung liegt bei KMD Johannes K.; das Werk wurde speziell für die räumlichen Gegebenheiten der Konzertkirche adaptiert.
            </p>
          </div>

          <div class="grid grid-cols-1 gap-4 border-t border-white/10 pt-8 sm:grid-cols-2" aria-label="Ensemble und Leitung">
            <Card as="section" class="border-white/5 bg-slate-mist/30 p-6 backdrop-blur-none">
              <h3 class="font-body text-xs/4 font-semibold uppercase tracking-widest text-primary">Ensemble</h3>
              <p class="mt-4 font-body text-base/7 text-role-on/70">Großer Sinfonischer Chor der Petruskirche &amp; Projektorchester Kiel</p>
            </Card>
            <Card as="section" class="border-white/5 bg-slate-mist/30 p-6 backdrop-blur-none">
              <h3 class="font-body text-xs/4 font-semibold uppercase tracking-widest text-primary">Leitung</h3>
              <p class="mt-4 font-body text-base/7 text-role-on/70">KMD Johannes K. (Musikalische Gesamtleitung)</p>
            </Card>
          </div>
        </article>

        <aside class="lg:sticky lg:top-32 lg:col-span-4" aria-labelledby="short-info-heading">
          <div class="overflow-hidden rounded-xl border border-white/10 bg-slate-mist/40 shadow-panel backdrop-blur-xl">
            <div class="h-2 bg-gradient-to-r from-transparent via-secondary/50 to-transparent" aria-hidden="true"></div>
            <div class="p-8">
              <h2 id="short-info-heading" class="block font-body text-xs/4 font-semibold uppercase tracking-widest text-role-on/60 mb-6">Kurzinfo</h2>
              <dl class="space-y-6">
                {
                  infoItems.map(([term, description]) => (
                    <div class="border-b border-white/5 pb-4 last:border-0 last:pb-0">
                      <dt class="mb-2 font-body text-xs/4 font-semibold uppercase tracking-widest text-role-on/60">{term}</dt>
                      <dd class="font-body text-base/7 text-primary">{description}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>
            {passionConcert.ticketUrl && (
              <div class="border-t border-white/10 bg-slate-mist/80 p-6" id="tickets">
                <a class="inline-flex min-h-14 w-full items-center justify-center rounded-lg bg-secondary px-6 py-4 font-body text-xs/4 font-semibold uppercase tracking-widest !text-midnight no-underline transition hover:bg-champagne active:scale-95" href={passionConcert.ticketUrl}>
                  Tickets im Vorverkauf →
                </a>
              </div>
            )}
          </div>
          <p class="mt-6 text-center">
            <a class="font-body text-xs/4 font-semibold uppercase tracking-widest !text-role-on/70 no-underline transition hover:!text-secondary" href="/besuch-planen">Ihren Besuch planen</a>
          </p>
        </aside>
      </div>
    </section>

    <section class="border-t border-white/5 bg-gradient-to-b from-transparent to-surface/50 py-20 md:py-24" aria-labelledby="related-heading">
      <div class="mx-auto w-full max-w-screen-2xl px-6 md:px-8 lg:px-16">
        <div class="mb-10 flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <h2 id="related-heading" class="block font-body text-xs/4 font-semibold uppercase tracking-widest text-role-on/60">Andere Konzerte</h2>
          <a class="inline-flex items-center gap-2 self-start font-body text-xs/4 font-semibold uppercase tracking-widest !text-secondary no-underline transition hover:!text-champagne md:self-auto" href="/programm">
            Gesamtes Programm
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          {relatedConcerts.map((concert) => <ConcertCard concert={concert} imageSizes="(min-width: 768px) 30vw, calc(100vw - 48px)" />)}
        </div>
      </div>
    </section>
  </main>

  {passionConcert.ticketUrl && (
    <a
      href={passionConcert.ticketUrl}
      class="fixed inset-x-0 bottom-0 z-50 flex min-h-14 items-center justify-center bg-secondary px-6 py-4 font-body text-xs/4 font-semibold uppercase tracking-widest !text-midnight no-underline shadow-panel transition hover:bg-champagne active:scale-95 md:hidden"
    >
      Tickets kaufen →
    </a>
  )}
</Layout>
