---
export const prerender = false;

import { env } from 'cloudflare:workers';

import fallbackImage from '../../assets/hero/l1130722-hero.jpg';
import { ButtonLink } from '../../components/ui/button';
import Layout from '../../layouts/Layout.astro';
import { cacheProgramme, getConcerts, getConcertState } from '../../data/concerts';

cacheProgramme(Astro.response);
const result = await getConcerts(env);
const concert = result.concerts.find(({ slug }) => slug === Astro.params.slug);
const state = concert ? getConcertState(concert) : undefined;
const isPast = state === 'past';
if (!concert) Astro.response.status = result.error ? 503 : 404;
const info = concert ? [
  ['Einlass', concert.admission],
  ['Dauer', concert.durationMinutes ? `${concert.durationMinutes} Minuten (Beginn bis Ende)` : undefined],
  ['Pause', concert.intermission],
  ['Ort', concert.location],
  ['Barrierefreiheit', concert.accessibility]
].filter(([, value]) => value) : [];
---

<Layout
  title={concert ? `${concert.title} · Konzertkirche Petruskirche` : 'Konzert nicht gefunden · Konzertkirche Petruskirche'}
  description={concert ? `${concert.title} am ${concert.date.display} – ${concert.location ?? 'Konzertkirche Petruskirche Kiel'}.` : 'Das angefragte Konzert wurde nicht gefunden.'}
>
  <main class="min-h-screen bg-midnight text-role-on">
    {concert ? (
      <div class="mx-auto grid w-full max-w-screen-2xl items-start gap-12 px-6 pb-20 pt-32 md:px-8 lg:grid-cols-12 lg:gap-16 lg:px-16">
        <article class:list={[concert.image ? 'lg:col-span-7' : 'lg:col-span-12']}>
          <header>
            {isPast && <p class="mb-6 font-body text-xs/4 font-semibold uppercase tracking-widest text-role-on/80">Vergangenes Konzert</p>}
            <h1 class="font-display text-4xl/tight font-normal tracking-tighter text-white sm:text-5xl/tight lg:text-6xl/tight">{concert.title}</h1>
            {concert.subtitle && <p class="mt-6 whitespace-pre-line font-body text-xl/8 text-role-on/85">{concert.subtitle}</p>}
            <p class="mt-6 font-display text-2xl/tight text-secondary"><time datetime={concert.date.iso}>{concert.date.display}</time></p>
          </header>

          {concert.shortDescription && <p class="mt-8 whitespace-pre-line font-body text-xl/8 text-role-on/85">{concert.shortDescription}</p>}
          {concert.longDescription && <div class="mt-8 whitespace-pre-line font-body text-lg/8 text-role-on/70">{concert.longDescription}</div>}

          {(concert.programme || concert.programmeNotes || concert.performers) && (
            <section class="mt-12" aria-labelledby="programme-notes-heading">
              <h2 id="programme-notes-heading" class="font-body text-xs/4 font-semibold uppercase tracking-widest text-secondary">Zum Programm</h2>
              {concert.programme && <p class="mt-6 whitespace-pre-line font-display text-2xl/relaxed text-white">{concert.programme}</p>}
              {concert.programmeNotes && <p class="mt-6 max-w-3xl whitespace-pre-line font-body text-lg/8 text-role-on/70">{concert.programmeNotes}</p>}
              {concert.performers && <p class="mt-6 whitespace-pre-line font-body text-lg/8 text-role-on/70"><span class="font-semibold text-white">Mitwirkende:</span> {concert.performers}</p>}
            </section>
          )}

          {info.length > 0 && (
            <section class="mt-12 rounded-xl border border-white/10 bg-slate-mist/40 p-8" aria-labelledby="concert-info-heading">
              <h2 id="concert-info-heading" class="font-body text-xs/4 font-semibold uppercase tracking-widest text-secondary">Kurzinfo</h2>
              <dl class="mt-6 grid gap-6 sm:grid-cols-2">
                {info.map(([label, value]) => (
                  <div>
                    <dt class="font-body text-xs/4 font-semibold uppercase tracking-widest text-role-on/60">{label}</dt>
                    <dd class="mt-2 whitespace-pre-line font-body text-base/7 text-white">{value}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}

          <div class="mt-8 flex flex-wrap items-center gap-6 border-t border-white/10 pt-6">
            {isPast ? (
              <a class="inline-flex min-h-12 items-center font-body text-xs/4 font-semibold uppercase tracking-widest !text-secondary no-underline hover:!text-champagne" href="/programm/archiv/">Zum Konzertarchiv →</a>
            ) : (
              <>
                {concert.ticketUrl && <ButtonLink className="min-h-14 rounded-sm bg-secondary px-6 py-4 font-body text-xs/4 font-semibold uppercase tracking-widest text-midnight hover:bg-champagne" href={concert.ticketUrl}>Tickets kaufen</ButtonLink>}
                <a class="inline-flex min-h-12 items-center font-body text-xs/4 font-semibold uppercase tracking-widest !text-secondary no-underline hover:!text-champagne" href="/besuch-planen/">Besuch planen →</a>
              </>
            )}
          </div>
        </article>

        {concert.image && (
          <aside class="w-full max-w-lg justify-self-center lg:sticky lg:top-28 lg:col-span-5" aria-label="Veranstaltungsbild">
            <a href={concert.image} aria-label={`Veranstaltungsbild zu ${concert.title} in voller Größe öffnen`} class="block aspect-[3/4] rounded-lg focus-visible:outline-offset-4">
              <img
                src={concert.image}
                alt={concert.imageAlt}
                class="h-full w-full rounded-lg object-contain"
                decoding="async"
                onerror={`this.onerror=null;this.srcset='';this.src='${fallbackImage.src}';this.alt='';this.parentElement.href=this.src`}
              />
            </a>
          </aside>
        )}
      </div>
    ) : (
      <section class="mx-auto flex min-h-[70vh] w-full max-w-screen-md flex-col justify-center px-6 py-32 text-center" aria-labelledby="missing-concert-heading">
        <p class="font-body text-xs/4 font-semibold uppercase tracking-widest text-secondary">Programm</p>
        <h1 id="missing-concert-heading" class="mt-6 font-display text-4xl/tight text-white">
          {result.error ? 'Programm vorübergehend nicht erreichbar' : 'Konzert nicht gefunden'}
        </h1>
        <p class="mt-6 font-body text-lg/8 text-role-on/70">
          {result.error ? 'Die Konzertdaten können gerade nicht geladen werden. Bitte versuchen Sie es später erneut.' : 'Dieser Termin existiert nicht oder wurde aus dem Programm entfernt.'}
        </p>
        <a class="mt-8 font-body text-sm font-semibold !text-secondary no-underline hover:!text-champagne" href="/programm/">Zum Konzertprogramm →</a>
      </section>
    )}
  </main>
</Layout>
