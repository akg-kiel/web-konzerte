---
import { Image } from 'astro:assets';
import { env } from 'cloudflare:workers';

import MailForm from '../components/sections/MailForm.astro';
import WikMap from '../components/sections/WikMap.astro';
import SectionNavigation from '../components/sections/SectionNavigation.astro';
import PageHero from '../components/sections/PageHero.astro';
import Card from '../components/ui/Card.astro';
import { ButtonLink } from '../components/ui/button';
import { TextField } from '../components/ui/text-field';
import Layout from '../layouts/Layout.astro';
import yonatanPandelaki from '../assets/team/yonatan-pandelaki.jpg';
import concertInterior from '../assets/venue/petruskirche-interior-concert.webp';
import { getContactSettings } from '../lib/contact-mail';
import { venue } from '../data/venue';

const contact = getContactSettings(env);
const inputClass =
  'h-auto rounded-none border-0 border-b border-role-on/50 bg-transparent px-0 py-4 font-body text-base/6 text-on-surface focus-visible:ring-secondary';
const labelClass =
  'mb-2 block font-body text-xs/4 font-semibold uppercase tracking-widest text-role-on/70';
---

<Layout
  title="Kontakt · Konzertkirche Petruskirche"
  description="Kontakt zur Konzertkirche Petruskirche Kiel: Ansprechpartner, Nachrichtenformular, Adresse und Anfahrt."
>
  <main class="min-h-screen bg-midnight text-role-on">
    <PageHero
      intro="Fragen zum Konzertbesuch oder zu einer Veranstaltung? Sie erreichen das Konzertbüro per Telefon, E-Mail oder über das Formular."
      image={concertInterior}
      imageAlt="Publikum bei einem Konzert im Innenraum der Petruskirche"
      imagePosition="50% 48%"
    >
      Kontakt
      <ButtonLink slot="cta" className="h-auto min-h-12 max-w-full whitespace-normal rounded-sm bg-secondary text-center px-6 py-3 font-body text-xs/4 font-semibold uppercase tracking-widest text-midnight hover:bg-champagne active:scale-95" href="#kontaktformular">Zum Kontaktformular</ButtonLink>
      <ButtonLink slot="cta" className="h-auto min-h-12 max-w-full whitespace-normal rounded-sm border-white/30 text-center bg-transparent px-6 py-3 font-body text-xs/4 font-semibold uppercase tracking-widest text-on-surface hover:border-secondary hover:bg-transparent hover:text-secondary" href="#anfahrt" variant="outline">Anfahrt ansehen</ButtonLink>
    </PageHero>

    <SectionNavigation links={[
      { href: '#nachricht', label: 'Kontakt' },
      { href: '#ueber-uns', label: 'Ansprechpartner' },
      { href: '#anfahrt', label: 'Anfahrt' }
    ]} />

    <section id="nachricht" class="py-16 md:py-24" aria-labelledby="contact-heading">
      <div class="mx-auto w-full max-w-screen-2xl px-6 md:px-8 lg:px-16">
        <h2 id="contact-heading" class="font-body text-xs/4 font-semibold uppercase tracking-widest text-secondary">Wie können wir helfen?</h2>

        <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="space-y-10 lg:col-span-4">
            <address class="space-y-8 font-body text-base/7 text-role-on/70 not-italic">
              <div>
                <p class="font-semibold text-on-surface">Konzertanfragen</p>
                <a class="block !text-secondary no-underline hover:!text-champagne" href={`mailto:${contact.email}`}>{contact.email}</a>
                <a class="block !text-secondary no-underline hover:!text-champagne" href={venue.concertPhone.href}>{venue.concertPhone.label}</a>
              </div>
              <div>
                <p class="font-semibold text-on-surface">Veranstaltungsort</p>
                <p>{venue.name}<br />{venue.address.street}<br />{venue.address.postalCode} {venue.address.city}</p>
              </div>
            </address>
            <p class="border-l border-secondary bg-secondary/5 py-4 pl-6 font-body text-base/7 text-role-on/75">Sie möchten die Petruskirche selbst nutzen? Technik, Pläne und Terminanfrage finden Sie unter <a class="!text-secondary no-underline hover:!text-champagne" href="/f%C3%BCr-veranstalter/">Raum anfragen</a>.</p>
          </div>

          <Card class="border-white/5 bg-slate-mist/20 p-8 lg:col-span-8 md:p-10">
            <h3 id="kontaktformular" tabindex="-1" class="font-display text-2xl/tight text-on-surface md:text-3xl/tight">Nachricht senden</h3>
            <p id="required-note" class="mt-4 max-w-prose font-body text-sm/6 text-role-on/60">Mit <span class="text-secondary">*</span> markierte Felder sind Pflichtfelder.{!contact.enabled && ' Beim Absenden öffnet sich Ihr E-Mail-Programm.'}</p>

            <MailForm kind="contact" class="mt-8" describedBy="required-note">
              <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
                <TextField inputClassName={inputClass} isRequired label="Name" labelClassName={labelClass} name="Name" autoComplete="name" minLength={2} maxLength={160} />
                <TextField inputClassName={inputClass} isRequired label="E-Mail" labelClassName={labelClass} name="E-Mail" autoComplete="email" type="email" maxLength={254} />
              </div>
              <TextField inputClassName={inputClass} isRequired label="Betreff" labelClassName={labelClass} name="Betreff" minLength={3} maxLength={160} />
              <TextField inputClassName="min-h-40 resize-y rounded-none border-0 border-b border-role-on/50 bg-transparent px-0 py-4 font-body text-base/6 text-on-surface focus-visible:ring-secondary" isRequired label="Nachricht" labelClassName={labelClass} name="Nachricht" minLength={10} maxLength={5000} multiline rows={6} />
            </MailForm>
          </Card>
        </div>
      </div>
    </section>

    <section id="ueber-uns" class="border-y border-white/5 bg-surface py-16 md:py-24" aria-labelledby="about-heading">
      <div class="mx-auto w-full max-w-5xl px-6 md:px-8">
        <Card as="article" class="grid bg-midnight/60 md:grid-cols-3">
          <figure>
            <scroll-reveal data-motion="image" class="block h-full">
              <Image
                src={yonatanPandelaki}
                alt="Porträt von Yonatan Pandelaki"
                class="h-full max-h-96 !w-full object-cover object-center md:max-h-none"
                widths={[320, 480, 640]}
                sizes="(min-width: 768px) 33vw, calc(100vw - 48px)"
                loading="lazy"
                decoding="async"
                format="webp"
              />
            </scroll-reveal>
            <figcaption class="sr-only">Foto: Yosua Pandelaki</figcaption>
          </figure>
          <div class="p-8 md:col-span-2 md:p-10 lg:p-12">
            <h2 id="about-heading" class="font-body text-xs/4 font-semibold uppercase tracking-widest text-secondary">Yonatan Pandelaki</h2>
            <p class="mt-2 font-body text-lg/7 font-semibold text-role-on/80">Konzertmanager der Petruskirche</p>
            <p class="mt-6 max-w-xl font-body text-base/7 text-role-on/70">Yonatan Pandelaki ist Ihr Ansprechpartner für Konzerte und Veranstaltungen in der Petruskirche – Kiels Konzertkirche. Die Konzertarbeit gehört zur Ev.-Luth. Apostel-Kirchengemeinde Kiel.</p>
            <address class="mt-6 font-body text-base/7 text-role-on/70 not-italic">
              Adalbertstraße 10 · 24106 Kiel<br />
              <a class="!text-secondary no-underline hover:!text-champagne" href={venue.concertPhone.href}>{venue.concertPhone.label}</a><br />
              <a class="!text-secondary no-underline hover:!text-champagne" href={`mailto:${contact.email}`}>{contact.email}</a>
            </address>
          </div>
        </Card>
      </div>
    </section>

    <section id="anfahrt" class="py-16 md:py-24" aria-labelledby="directions-heading">
      <div class="mx-auto grid w-full max-w-screen-2xl grid-cols-1 gap-12 px-6 md:px-8 lg:grid-cols-12 lg:gap-16 lg:px-16">
        <div class="lg:col-span-5">
          <h2 id="directions-heading" class="font-body text-xs/4 font-semibold uppercase tracking-widest text-secondary">Anfahrt zur Petruskirche</h2>
          <p class="mt-4 font-body text-lg/7 text-on-surface">Weimarer Straße 1 · 24106 Kiel</p>
          <div class="mt-8 space-y-6 font-body text-base/7 text-role-on/70">
            <div>
              <h3 class="font-semibold text-on-surface">Anfahrt &amp; Parken</h3>
              <a class="mt-2 inline-flex min-h-11 items-center text-secondary underline underline-offset-4 hover:text-champagne" href="/besuch-planen/#anfahrt">Busverbindungen &amp; Parkmöglichkeiten ansehen</a>
            </div>
            <div>
              <h3 class="font-semibold text-on-surface">Barrierefrei ankommen</h3>
              <p class="mt-2">{venue.accessibility.entrance}</p>
              <a class="mt-2 inline-flex min-h-11 items-center text-secondary underline underline-offset-4 hover:text-champagne" href="/besuch-planen/#barrierefreiheit">Zugang, WC &amp; Rollstuhlplätze</a>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <WikMap id="contact-wik-map" />
        </div>
      </div>
    </section>
  </main>

</Layout>
