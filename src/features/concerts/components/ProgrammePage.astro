---
import { env } from 'cloudflare:workers';
import { ClientRouter } from 'astro:transitions';

import PageMetadata from '../../../components/layout/PageMetadata.astro';
import { venue, venueAddress } from '../../../data/venue.ts';
import Layout from '../../../layouts/Layout.astro';
import { getConcerts } from '../churchtools.server.ts';
import { getProgrammeExpiry, getProgrammeResults, paginateConcerts, splitConcerts } from '../concerts.ts';
import { cacheProgramme } from '../seo.ts';
import ConcertFilters from './ConcertFilters.astro';
import Concerts from './Concerts.astro';
import ProgrammeEmptyState from './ProgrammeEmptyState.astro';
import ProgrammeHeader from './ProgrammeHeader.astro';

interface Props { archive?: boolean }
const { archive = false } = Astro.props;
cacheProgramme(Astro.response);
// An expired local view must not be refreshed from another stale HTML snapshot.
Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'public, max-age=0');
const result = await getConcerts(env);
const now = new Date();
const { programmeConcerts, archiveConcerts } = splitConcerts(result.concerts, now);
const baseViews = [
  { key: 'programme', path: '/programm/', anchor: 'programm', variant: 'programme' as const,
    title: 'Konzerte in Kiel | Programm der Petruskirche',
    description: 'Aktuelle Konzerte in Kiel: Programm der Petruskirche mit Klassik, Chor, Musical, Orgel und Crossover sowie Ticketlinks, sobald der Vorverkauf startet.',
    concerts: programmeConcerts, eyebrow: 'Alle Konzerte' },
  { key: 'archive', path: '/programm/archiv/', anchor: 'archiv', variant: 'archive' as const,
    title: 'Konzertarchiv · Konzertkirche Petruskirche',
    description: 'Vergangene Konzerte und Programme der Konzertkirche Petruskirche Kiel.',
    concerts: archiveConcerts, eyebrow: 'Vergangene Konzerte' }
];
const active = baseViews[archive ? 1 : 0];
const query = getProgrammeResults(active.concerts, Astro.site!, Astro.url);
const views = baseViews.map((view) => ({
  ...view, ...paginateConcerts(view.concerts, new URLSearchParams()),
  id: query.hasResultView && view === active ? `${view.anchor}-base` : view.anchor,
  url: new URL(view.path, Astro.url), visible: !query.hasResultView && view === active
}));
if (query.hasResultView) {
  const { pageConcerts, page, pageCount, filters } = query;
  views.push({
    ...active, pageConcerts, page, pageCount, key: 'query', id: active.anchor, url: Astro.url,
    eyebrow: Object.values(filters).some(Boolean) ? 'Suchergebnisse' : active.eyebrow,
    visible: true
  });
}
const baseEmptyReason = result.error ? 'unavailable' : 'empty';
const searchEmptyReason = query.rangeError ? 'invalid-range' : 'filtered';
if (result.error) Astro.response.status = 503;
---

<Layout canonicalUrl={query.canonicalUrl} noindex={query.noindex} title={active.title} description={active.description} clientNavigation>
  <ClientRouter slot="head" fallback="swap" />
  <main data-programme-surface data-programme-rendered-at={now.getTime()} data-programme-expires={result.error ? 0 : getProgrammeExpiry(result.concerts, now)} class="min-h-screen bg-midnight text-role-on">
    <ProgrammeHeader>
      <ConcertFilters action={active.path} anchor={active.anchor} filters={query.filters} matchCount={result.error || query.rangeError ? undefined : query.matchCount} rangeError={query.rangeError} totalCount={active.concerts.length} />
    </ProgrammeHeader>
    {views.map((view) => (
      <div data-programme-panel={view.key} data-programme-path={view.path} data-programme-anchor={view.anchor} data-programme-summary={`${view.concerts.length} ${view.concerts.length === 1 ? 'Konzert' : 'Konzerte'} gefunden`} hidden={!view.visible} inert={!view.visible}>
        <Concerts id={view.id} cardIdPrefix={view.key} anchor={view.anchor} url={view.url} concerts={view.pageConcerts} variant={view.variant} page={view.page} pageCount={view.pageCount} eyebrow={view.eyebrow} showHeaderLink={false}>
          <ProgrammeEmptyState slot="empty" archive={view.variant === 'archive'} reason={
            view.key === 'query' && !result.error ? searchEmptyReason : baseEmptyReason
          } />
        </Concerts>
        {view.variant === 'programme' && (
          <section class="border-t border-white/5 bg-surface py-16 md:py-20" aria-labelledby={`venue-heading-${view.key}`}>
            <div class="mx-auto grid w-full max-w-screen-2xl gap-8 px-6 md:grid-cols-2 md:px-8 lg:px-16">
              <div>
                <h2 id={`venue-heading-${view.key}`} class="font-body text-xs/4 font-semibold uppercase tracking-widest text-secondary">Veranstaltungsort</h2>
                <p class="mt-4 font-display text-2xl/tight text-white">{venue.name}</p>
                <p class="mt-2 font-body text-base/7 text-role-on/70">{venueAddress}</p>
              </div>
              <div>
                <h2 class="font-body text-xs/4 font-semibold uppercase tracking-widest text-secondary">Barrierefreiheit</h2>
                <p class="mt-4 max-w-xl font-body text-base/7 text-role-on/70">{venue.accessibility.entrance}</p>
                <a class="mt-4 inline-flex min-h-11 items-center font-body text-xs/4 font-semibold uppercase tracking-widest !text-secondary no-underline hover:!text-champagne" href="/besuch-planen/#barrierefreiheit">Zugang, WC &amp; Rollstuhlplätze →</a>
              </div>
            </div>
          </section>
        )}
      </div>
    ))}
    {baseViews.map((view) => (
      <template data-programme-head={view.path}>
        <PageMetadata title={view.title} description={view.description} canonicalUrl={view.path} />
      </template>
    ))}
  </main>
</Layout>

<script>
  import '../programme-navigation';
</script>
