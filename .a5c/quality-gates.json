{
  "qualityThreshold": "${BABYSITTER_QUALITY_THRESHOLD:-80}",
  "testCoverage": {
    "minimum": 0,
    "target": 60,
    "note": "No dedicated test framework is configured yet; Vite+ static checks, context audit, and the Astro production build are the required baseline."
  },
  "staticChecks": {
    "tools": ["Vite+ check", "Oxfmt", "Oxlint", "TypeScript/tsgo"],
    "commands": ["vp check ."]
  },
  "contextAudit": {
    "tools": ["Project context audit"],
    "commands": ["vp run context:check"]
  },
  "formatting": {
    "tools": ["Vite+ fmt / Oxfmt"],
    "commands": ["vp check ."]
  },
  "build": {
    "tools": ["Astro Check", "Astro Build"],
    "commands": ["vp run build"],
    "output": "dist"
  },
  "commitChecks": ["vp run quality"],
  "deployGates": [
    "Vite+ check passes",
    "context audit passes",
    "Astro production build succeeds",
    "manual responsive/accessibility review for UI changes",
    "Cloudflare static asset assumptions preserved"
  ],
  "cicdIntegration": {
    "provider": "GitHub Actions",
    "workflow": ".github/workflows/babysitter.yml",
    "events": ["pull_request", "workflow_dispatch"]
  }
}
